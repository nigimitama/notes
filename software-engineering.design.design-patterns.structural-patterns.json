ype":"text","value":"個々のオブジェクトとその集合を同じインターフェースで扱えるようにし、木構造（部分-全体階層）を統一的に扱うパターン。\nファイルシステムのファイル/ディレクトリ、UIコンポーネントツリーなどが典型例。","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"yyBsuQNbDB"}],"key":"ftYy5WvYkq"}],"key":"nHvkPtQD7F"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"class FileSystemItem:\n    def size(self): raise NotImplementedError\n\nclass File(FileSystemItem):\n    def __init__(self, size):\n        self._size = size\n\n    def size(self):\n        return self._size\n\nclass Directory(FileSystemItem):\n    def __init__(self):\n        self.children = []\n\n    def add(self, item: FileSystemItem):\n        self.children.append(item)\n\n    def size(self):\n        return sum(child.size() for child in self.children)\n\nroot = Directory()\nroot.add(File(100))\nsub = Directory()\nsub.add(File(50))\nroot.add(sub)\nprint(root.size())  # 150","visibility":"show","key":"GQuOxBkmN5"},{"type":"outputs","id":"8WBSAjgFbGXlfYGfpRCRt","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"150\n"},"children":[],"key":"ZedyQZUNNU"}],"visibility":"show","key":"eODgG84p6f"}],"visibility":"show","key":"AmjDHE4SiW"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"参考","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"dkrLsW4mIp"}],"identifier":"id","label":"参考","html_id":"id","implicit":true,"key":"pgDrvxjmpc"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"構造に関するデザインパターン","position":{"start":{"line":3,"column":1},"e