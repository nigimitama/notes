append(0)\n    while len(todo) > 0:\n        target_node: int = todo.pop()\n        print(f\"searching a node '{target_node}'\")\n        for adj_node in adjacent_nodes[target_node]:\n            if not searched[adj_node]:\n                print(f\"{adj_node} is found and enqueued to todo\")\n                todo.append(adj_node)\n                searched[adj_node] = True\n\n\n# 隣接リスト表現 (adjacency-list representation)したグラフ\nedges: List[list] = [\n    [0, 1],  # 0 - 1 の辺\n    [0, 2],\n    [1, 3]\n]\ndfs(edges)","key":"He2BMEQou6"},{"type":"outputs","id":"9M40X5i29fnKQOeM4XJP8","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"searching a node '0'\n1 is found and enqueued to todo\n2 is found and enqueued to todo\nsearching a node '2'\nsearching a node '1'\n3 is found and enqueued to todo\nsearching a node '3'\n"},"children":[],"key":"Xq4HNrkv7T"}],"key":"nnEf2oCDDV"}],"key":"IVANTEX8fL"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"YfSiv2B6B2"},{"type":"outputs","id":"VaY1OPOUSG8cVTXek4Mt_","children":[],"key":"svYn5XB4GM"}],"key":"EFYh4aDeZr"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"ダイクストラ法","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"n1Fcqsn07g"}],"identifier":"id","label":"ダイクストラ法","html_id":"id","implicit":true,"key":"cOkpcltp7n"}],"key":"UBytC8uD3v"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"e0ew38Hsv2"},{"type":"outputs","id":"OdmaTSJ3sy2d9G6wpuzCG","children":[],"key":"w4vW8vv1oO"}],"key":"zzBbBZgxsR"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"計算量","