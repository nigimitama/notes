append(0)\n    while len(todo) > 0:\n        target_node: int = todo.pop()\n        print(f\"searching a node '{target_node}'\")\n        for adj_node in adjacent_nodes[target_node]:\n            if not searched[adj_node]:\n                print(f\"{adj_node} is found and enqueued to todo\")\n                todo.append(adj_node)\n                searched[adj_node] = True\n\n\n# 隣接リスト表現 (adjacency-list representation)したグラフ\nedges: List[list] = [\n    [0, 1],  # 0 - 1 の辺\n    [0, 2],\n    [1, 3]\n]\ndfs(edges)","key":"rTgsvQlzR9"},{"type":"outputs","id":"9uvxBlztfQcnctVlQzBh5","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"searching a node '0'\n1 is found and enqueued to todo\n2 is found and enqueued to todo\nsearching a node '2'\nsearching a node '1'\n3 is found and enqueued to todo\nsearching a node '3'\n"},"children":[],"key":"lzdPwBl4kY"}],"key":"kzeCIRpTTa"}],"key":"BvsKK57q5F"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"WVYJBykmX8"},{"type":"outputs","id":"R140Pfhg-4xIuXI7ohorc","children":[],"key":"z2unEJhZTW"}],"key":"vUPYeTaPGS"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"ダイクストラ法","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"PPLMg2oIsw"}],"identifier":"id","label":"ダイクストラ法","html_id":"id","implicit":true,"key":"x0Qkw0UH2B"}],"key":"TQcc1h7UZ7"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"Xxsgd5Bx1b"},{"type":"outputs","id":"GGiUSgkRc8PrQRv2c-UR0","children":[],"key":"UDIFi1mSmq"}],"key":"Zf3mTZnvT6"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"計算量","