append(0)\n    while len(todo) > 0:\n        target_node: int = todo.pop()\n        print(f\"searching a node '{target_node}'\")\n        for adj_node in adjacent_nodes[target_node]:\n            if not searched[adj_node]:\n                print(f\"{adj_node} is found and enqueued to todo\")\n                todo.append(adj_node)\n                searched[adj_node] = True\n\n\n# 隣接リスト表現 (adjacency-list representation)したグラフ\nedges: List[list] = [\n    [0, 1],  # 0 - 1 の辺\n    [0, 2],\n    [1, 3]\n]\ndfs(edges)","key":"B3Pb3mkMOD"},{"type":"outputs","id":"4fax9iURe79bQ2ZeU_Q3_","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"searching a node '0'\n1 is found and enqueued to todo\n2 is found and enqueued to todo\nsearching a node '2'\nsearching a node '1'\n3 is found and enqueued to todo\nsearching a node '3'\n"},"children":[],"key":"hPfdx3PikD"}],"key":"k2XMxkGext"}],"key":"IUURNKFt42"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"RK7WkQHuq4"},{"type":"outputs","id":"6gkCuDQDb-c-w4n-4vdp_","children":[],"key":"ChwITxbmAS"}],"key":"pCRSNdF9Sw"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"ダイクストラ法","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"UbSC8nXNSY"}],"identifier":"id","label":"ダイクストラ法","html_id":"id","implicit":true,"key":"c9fI0xRZ2G"}],"key":"Ahc27CaiFw"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"YQiMlEQiUt"},{"type":"outputs","id":"dvG0UN6y4_pdj2ywzViEB","children":[],"key":"JcO7swbA8W"}],"key":"ET2343bzmy"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"計算量","