append(0)\n    while len(todo) > 0:\n        target_node: int = todo.pop()\n        print(f\"searching a node '{target_node}'\")\n        for adj_node in adjacent_nodes[target_node]:\n            if not searched[adj_node]:\n                print(f\"{adj_node} is found and enqueued to todo\")\n                todo.append(adj_node)\n                searched[adj_node] = True\n\n\n# 隣接リスト表現 (adjacency-list representation)したグラフ\nedges: List[list] = [\n    [0, 1],  # 0 - 1 の辺\n    [0, 2],\n    [1, 3]\n]\ndfs(edges)","key":"RS1mzTmD23"},{"type":"outputs","id":"S30H0H5SSNPvnkONzroMU","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"searching a node '0'\n1 is found and enqueued to todo\n2 is found and enqueued to todo\nsearching a node '2'\nsearching a node '1'\n3 is found and enqueued to todo\nsearching a node '3'\n"},"children":[],"key":"UbPTegJEUq"}],"key":"pbo7Ke86t5"}],"key":"IJ3tSGeb5X"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"M1HmofTZwh"},{"type":"outputs","id":"KB2XHGeHAckyxbtZX5AVb","children":[],"key":"ej4PUydSrI"}],"key":"qAO7k6MMc6"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"ダイクストラ法","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"SldGFkriz5"}],"identifier":"id","label":"ダイクストラ法","html_id":"id","implicit":true,"key":"mn09DzgI4d"}],"key":"c3Pq6XGjwk"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"rjHyT5hQGN"},{"type":"outputs","id":"pXa6PzDB8EbuIs8fruMhT","children":[],"key":"rVH8hngiHq"}],"key":"M1erjdcFcU"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"計算量","