append(0)\n    while len(todo) > 0:\n        target_node: int = todo.pop()\n        print(f\"searching a node '{target_node}'\")\n        for adj_node in adjacent_nodes[target_node]:\n            if not searched[adj_node]:\n                print(f\"{adj_node} is found and enqueued to todo\")\n                todo.append(adj_node)\n                searched[adj_node] = True\n\n\n# 隣接リスト表現 (adjacency-list representation)したグラフ\nedges: List[list] = [\n    [0, 1],  # 0 - 1 の辺\n    [0, 2],\n    [1, 3]\n]\ndfs(edges)","key":"bM5lZkQ5qn"},{"type":"outputs","id":"0G2G92TA1VZalaTJMgphi","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"searching a node '0'\n1 is found and enqueued to todo\n2 is found and enqueued to todo\nsearching a node '2'\nsearching a node '1'\n3 is found and enqueued to todo\nsearching a node '3'\n"},"children":[],"key":"SlKtypG7mt"}],"key":"qgu1yapSv4"}],"key":"F49UkKaGIR"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"jQhrKTOad9"},{"type":"outputs","id":"E7wefF1sJLBKK50GEYoUJ","children":[],"key":"fJUrqckeE6"}],"key":"xQfSlwmUZI"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"ダイクストラ法","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"JNPpIcht6S"}],"identifier":"id","label":"ダイクストラ法","html_id":"id","implicit":true,"key":"lqip4rj7cU"}],"key":"bzLQzs0qav"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"gO0xShknnj"},{"type":"outputs","id":"nV9azbjbwJdlFv2Ms2Ug2","children":[],"key":"DLBlFWHlk0"}],"key":"Ti8fX79ct3"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"計算量","