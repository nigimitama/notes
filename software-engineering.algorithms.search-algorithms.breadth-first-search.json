append(0)\n    while len(todo) > 0:\n        target_node: int = todo.pop()\n        print(f\"searching a node '{target_node}'\")\n        for adj_node in adjacent_nodes[target_node]:\n            if not searched[adj_node]:\n                print(f\"{adj_node} is found and enqueued to todo\")\n                todo.append(adj_node)\n                searched[adj_node] = True\n\n\n# 隣接リスト表現 (adjacency-list representation)したグラフ\nedges: List[list] = [\n    [0, 1],  # 0 - 1 の辺\n    [0, 2],\n    [1, 3]\n]\ndfs(edges)","key":"to4cv7fvvh"},{"type":"outputs","id":"1JQ_qFUQvjT8BTCiaqRes","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"searching a node '0'\n1 is found and enqueued to todo\n2 is found and enqueued to todo\nsearching a node '2'\nsearching a node '1'\n3 is found and enqueued to todo\nsearching a node '3'\n"},"children":[],"key":"nx7iF7j8yM"}],"key":"W7VFPe2n7w"}],"key":"svO4cOeBXX"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"kHkZ5BMYGt"},{"type":"outputs","id":"5NaCve6zPnUpBnpP3uKFo","children":[],"key":"vV2Dd2NIP6"}],"key":"LOw7r7sso8"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"ダイクストラ法","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"y49Ma46l3z"}],"identifier":"id","label":"ダイクストラ法","html_id":"id","implicit":true,"key":"y130CRgMeB"}],"key":"mA3f3r1hCG"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"jaEzQw3StF"},{"type":"outputs","id":"YVSMAK-5byOrBKOi1ZHL3","children":[],"key":"vLUWOiDQEQ"}],"key":"YJpGuc0f1d"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"計算量","