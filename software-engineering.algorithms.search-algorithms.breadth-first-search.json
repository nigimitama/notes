append(0)\n    while len(todo) > 0:\n        target_node: int = todo.pop()\n        print(f\"searching a node '{target_node}'\")\n        for adj_node in adjacent_nodes[target_node]:\n            if not searched[adj_node]:\n                print(f\"{adj_node} is found and enqueued to todo\")\n                todo.append(adj_node)\n                searched[adj_node] = True\n\n\n# 隣接リスト表現 (adjacency-list representation)したグラフ\nedges: List[list] = [\n    [0, 1],  # 0 - 1 の辺\n    [0, 2],\n    [1, 3]\n]\ndfs(edges)","key":"FHu9gKBA0m"},{"type":"outputs","id":"8j8C7FEmBDnuaueeOL3Rm","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"searching a node '0'\n1 is found and enqueued to todo\n2 is found and enqueued to todo\nsearching a node '2'\nsearching a node '1'\n3 is found and enqueued to todo\nsearching a node '3'\n"},"children":[],"key":"NsAhdY4K0h"}],"key":"pweOOanWss"}],"key":"RT9eG56win"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"u4bvvcGcki"},{"type":"outputs","id":"ERQdurZ35N-5UEZU-1zCI","children":[],"key":"T7dehB85vG"}],"key":"KUZTAHcGMH"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"ダイクストラ法","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"XgukHmGn9m"}],"identifier":"id","label":"ダイクストラ法","html_id":"id","implicit":true,"key":"AA3R6SNXBO"}],"key":"qQo6H3XZiZ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"APdDX3uaEx"},{"type":"outputs","id":"iVtvHbLxB5o3CdS2rNm9x","children":[],"key":"PONqR1BGqy"}],"key":"XSxVH3jwgi"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"計算量","