append(0)\n    while len(todo) > 0:\n        target_node: int = todo.pop()\n        print(f\"searching a node '{target_node}'\")\n        for adj_node in adjacent_nodes[target_node]:\n            if not searched[adj_node]:\n                print(f\"{adj_node} is found and enqueued to todo\")\n                todo.append(adj_node)\n                searched[adj_node] = True\n\n\n# 隣接リスト表現 (adjacency-list representation)したグラフ\nedges: List[list] = [\n    [0, 1],  # 0 - 1 の辺\n    [0, 2],\n    [1, 3]\n]\ndfs(edges)","key":"xv71dkHBG5"},{"type":"outputs","id":"oJkxg3tdnmM3LfWlNAMz6","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"searching a node '0'\n1 is found and enqueued to todo\n2 is found and enqueued to todo\nsearching a node '2'\nsearching a node '1'\n3 is found and enqueued to todo\nsearching a node '3'\n"},"children":[],"key":"nvu1kmJCw1"}],"key":"NntOHfxuc9"}],"key":"LlK3di4Ifi"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"eqiAxsoLHv"},{"type":"outputs","id":"fFEKaCQ4WhkvPrR-h6ScX","children":[],"key":"ucY2KhTyfY"}],"key":"KHuQ8wdp4A"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"ダイクストラ法","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"B8AcZedPEz"}],"identifier":"id","label":"ダイクストラ法","html_id":"id","implicit":true,"key":"EUuQDNnYMX"}],"key":"g6wGaQ4sp5"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"kc9JIle89z"},{"type":"outputs","id":"8rPquVGwNAfQmwPOeZJ91","children":[],"key":"qPzix57ggV"}],"key":"qmVjpzlu1N"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"計算量","