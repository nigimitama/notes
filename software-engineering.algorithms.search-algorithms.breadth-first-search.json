append(0)\n    while len(todo) > 0:\n        target_node: int = todo.pop()\n        print(f\"searching a node '{target_node}'\")\n        for adj_node in adjacent_nodes[target_node]:\n            if not searched[adj_node]:\n                print(f\"{adj_node} is found and enqueued to todo\")\n                todo.append(adj_node)\n                searched[adj_node] = True\n\n\n# 隣接リスト表現 (adjacency-list representation)したグラフ\nedges: List[list] = [\n    [0, 1],  # 0 - 1 の辺\n    [0, 2],\n    [1, 3]\n]\ndfs(edges)","key":"bZdViiQbWI"},{"type":"outputs","id":"rE2W6G3L2uyLkSTsnAoJe","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"searching a node '0'\n1 is found and enqueued to todo\n2 is found and enqueued to todo\nsearching a node '2'\nsearching a node '1'\n3 is found and enqueued to todo\nsearching a node '3'\n"},"children":[],"key":"nf4QXrxNaB"}],"key":"WX4OKkrKLy"}],"key":"NWzV9mLMK8"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"qm0d9BSVG1"},{"type":"outputs","id":"C527DuOMmC8w1bUhjS4Vt","children":[],"key":"s4hvd30CyI"}],"key":"hlR7NsBrgy"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"ダイクストラ法","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"m0sFf55t2t"}],"identifier":"id","label":"ダイクストラ法","html_id":"id","implicit":true,"key":"jwVkED1I8U"}],"key":"nZzKkRNJtY"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"ItUe6O6xrz"},{"type":"outputs","id":"vsPFFOF3CV8ArmfBsPmi2","children":[],"key":"qdzZewhAlR"}],"key":"bey9wGGjM4"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"計算量","