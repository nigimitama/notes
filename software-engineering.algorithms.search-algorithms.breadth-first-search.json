append(0)\n    while len(todo) > 0:\n        target_node: int = todo.pop()\n        print(f\"searching a node '{target_node}'\")\n        for adj_node in adjacent_nodes[target_node]:\n            if not searched[adj_node]:\n                print(f\"{adj_node} is found and enqueued to todo\")\n                todo.append(adj_node)\n                searched[adj_node] = True\n\n\n# 隣接リスト表現 (adjacency-list representation)したグラフ\nedges: List[list] = [\n    [0, 1],  # 0 - 1 の辺\n    [0, 2],\n    [1, 3]\n]\ndfs(edges)","key":"aoo3cH0o8o"},{"type":"outputs","id":"_2mclX_H1usn4QOVX1aUV","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"searching a node '0'\n1 is found and enqueued to todo\n2 is found and enqueued to todo\nsearching a node '2'\nsearching a node '1'\n3 is found and enqueued to todo\nsearching a node '3'\n"},"children":[],"key":"xgx2vZvfhc"}],"key":"zGr4A0nf5E"}],"key":"LCuqCqmC93"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"ExzBLsQ9LV"},{"type":"outputs","id":"fd7JjzPBjEPZBT9F3xBuc","children":[],"key":"MlkWy1oTa7"}],"key":"baiyEurkhu"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"ダイクストラ法","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"D3y1SdvhMl"}],"identifier":"id","label":"ダイクストラ法","html_id":"id","implicit":true,"key":"dyvIxO7fI4"}],"key":"B3n3TeteSW"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"ztoE6sQSc5"},{"type":"outputs","id":"5Ig5I8Sy8OlAHs-nAiTAl","children":[],"key":"Tkck8jtCh8"}],"key":"o1wmXbtb8H"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"計算量","