row == n:\n            results.append(queens[:])\n            return\n        for col in range(n):\n            if col in cols or (row - col) in diag1 or (row + col) in diag2:\n                continue  # 枝刈り\n            queens.append(col)\n            cols.add(col)\n            diag1.add(row - col)\n            diag2.add(row + col)\n            backtrack(row + 1)\n            queens.pop()       # バックトラック\n            cols.remove(col)\n            diag1.remove(row - col)\n            diag2.remove(row + col)\n\n    backtrack(0)\n    return results\n\n\nsolutions = n_queens(6)\nprint(f'6-クイーンの解の数: {len(solutions)}')\nprint(f'最初の解 (列インデックス): {solutions[0]}')","key":"jyZXNlZ4zF"},{"type":"outputs","id":"3qBZ3Kshycxhdjz9tTQZ6","children":[],"key":"dPw0qKe2A7"}],"key":"MThmYA0C3n"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"例3: 順列生成（重複なし）","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"U3eB7hyz7B"}],"identifier":"id-3","label":"例3: 順列生成（重複なし）","html_id":"id-3","implicit":true,"key":"huToSmhPMh"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"inlineCode","value":"itertools.permutations","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"p9K8QEMtSp"},{"type":"text","value":" と同じ結果を、バックトラッキングで実装する例","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"JF6Je7svsi"}],"key":"aJzRbxihO1"}],"key":"BZWzAGE3jJ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def permutations_bt(nums: list) -> list[list]:\n    results = []\n    used = [False] * len(nums)\n\n    def backtrack(current: list):\n        if len(current) == len(nums):\n            results.append(current[:])\n            return\n        for i, num in enumerate(nums):\n    