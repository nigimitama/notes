.55em;margin-left:-0.0269em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mathnormal mtight\">i</span></span></span></span><span class=\"vlist-s\">​</span></span><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.15em;\"><span></span></span></span></span></span></span></span></span></span>","key":"kGgYKrDMsS"},{"type":"text","value":"）が高いアイテムから詰める。","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"aGpG7MHsIQ"}],"key":"TYjym8zQuM"},{"type":"blockquote","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"※ アイテムの分割が許されない ","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"eJlf9kvJ3K"},{"type":"strong","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"0/1 ナップサック問題","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"SznHEyMAZU"}],"key":"lIJjyFd0oS"},{"type":"text","value":" では貪欲法では最適解が保証されない（動的計画法が必要）。","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"S92Od9mbQp"}],"key":"A8Y5IN15pF"}],"key":"g87outUeN4"}],"key":"CdHnspoBSk"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def fractional_knapsack(capacity: float, items: list[tuple[float, float]]) -> float:\n    \"\"\"\n    分数ナップサック問題\n\n    Parameters\n    ----------\n    capacity : float\n        ナップサックの容量\n    items : list of (weight, value)\n\n    Returns\n    -------\n    float\n        最大価値\n    \"\"\"\n    # 単位重量あたりの価値で降順ソート\n    sorted_items = sorted(items, key=lambda x: x[1] / x[0], reverse=True)\n    total_value = 0.0\n    remaining = capacity\n\n    for weight, value in sorted_items:\n        if remaining <= 0:\n            break\n        take = min(weight, remaining)\n        total_value += value * (take / weight)\n        remaining -= take\n\n    return total_value\n\n\ncapacity = 50\nitems = [\n    (10, 60),  # 重さ10, 価値60  → 単価6.0\n    (20, 100), # 重さ20, 価値100 → 単価5.0\n    (30, 120), # 重さ30, 価値120 → 単価4.0\n]\n\nmax_value = fractional_knapsack(capacity, items)\nprint(f\"最大価値: {max_value}\")","key":"ICkGwfExyH"},{"type":"outputs","id":"kUdJ7ekNfQCSUI46q5GYz","children":[],"key":"PpNbLHceuL"}],"key":"hx8mueyzem"}],"key":"LCa1cOKBde"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"全探索 / 総当り法","url":"/software-engineering/algorithms/design/brute-force-search","group":"ソフトウェア工学"},"next":{"title":"動的計画法","url":"/software-engineering/algorithms/design/dynamic-programming","group":"ソフトウェア工学"}}},"domain":"http://localhost:3000"}