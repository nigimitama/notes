en":[{"type":"code","lang":"python","executable":true,"value":"import heapq\nfrom collections import defaultdict\n\ndef dijkstra(graph: dict, start: int) -> dict:\n    \"\"\"\n    Parameters\n    ----------\n    graph : dict\n        隣接リスト。graph[u] = [(v, weight), ...] の形式\n    start : int\n        始点の頂点番号\n\n    Returns\n    -------\n    dict\n        各頂点への最短距離。到達不能な頂点は float('inf')\n    \"\"\"\n    dist = defaultdict(lambda: float(\"inf\"))\n    dist[start] = 0\n    heap = [(0, start)]  # (distance, vertex)\n\n    while heap:\n        d, u = heapq.heappop(heap)\n        if d > dist[u]:\n            continue  # すでにより短い距離で確定済み\n        for v, w in graph[u]:\n            new_dist = dist[u] + w\n            if new_dist < dist[v]:\n                dist[v] = new_dist\n                heapq.heappush(heap, (new_dist, v))\n\n    return dict(dist)\n\n\n# --- 使用例 ---\n#\n#     1\n#   /   \\\n#  0  2  3\n#   \\   /\n#    2\n#\ngraph = defaultdict(list)\nedges = [(0, 1, 1), (0, 2, 4), (1, 2, 2), (1, 3, 5), (2, 3, 1)]\nfor u, v, w in edges:\n    graph[u].append((v, w))\n    graph[v].append((u, w))  # 無向グラフ\n\ndist = dijkstra(graph, start=0)\nprint(\"始点 0 からの最短距離:\")\nfor v in sorted(dist):\n    print(f\"  頂点 {v}: {dist[v]}\")","key":"GyNUWNNl8x"},{"type":"outputs","id":"_vTKebwAdZd_0Jj-7py7i","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"始点 0 からの最短距離:\n  頂点 0: 0\n  頂点 1: 1\n  頂点 2: 3\n  頂点 3: 4\n"},"children":[],"key":"Y88QjdRLV4"}],"key":"SpUrqTustd"}],"key":"O24LqcDQYS"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"経路復元","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"eiAodmYgih"}],"identifier":"id","label":"経路復元","html_id":"id-4","implicit":true,"key":"EzacNevGxv"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"最短経路そのものを復元したい場合は、各頂点の直前の頂点（predecessor）を記録しておく。","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"pe22Qfftwj"}],"key":"j8jgNw2snP"}],"key":"HAwxZWuGau"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def dijkstra_with_path(graph: dict, start: int) -> tuple[dict, dict]:\n    dist = defaultdict(lambda: float(\"inf\"))\n    prev = {}\n    dist[start] = 0\n    heap = [(0, start)]\n\n    while heap:\n        d, u = heapq.heappop(heap)\n        if d > dist[u]:\n            continue\n        for v, w in graph[u]:\n            new_dist = dist[u] + w\n            if new_dist < dist[v]:\n                dist[v] = new_dist\n                prev[v] = u\n                heapq.heappush(heap, (new_dist, v))\n\n    return dict(dist), prev\n\n\ndef reconstruct_path(prev: dict, start: int, goal: int) -> list[int]:\n    path = []\n    v = goal\n    while v != start:\n        if v not in prev:\n            return []  # 到達不能\n        path.append(v)\n        v = prev[v]\n    path.append(start)\n    return path[::-1]\n\n\ndist, prev = dijkstra_with_path(graph, start=0)\npath = reconstruct_path(prev, start=0, goal=3)\nprint(f\"0 → 3 の最短経路: {' → '.join(map(str, path))}, 距離: {dist[3]}\")","key":"onGX1dXfPC"},{"type":"outputs","id":"LVY6TX0IyV0nWOTa9c_13","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"0 → 3 の最短経路: 0 → 1 → 2 → 3, 距離: 4\n"},"children":[],"key":"Jt1h5F0WpN"}],"key":"RAOOxSXbIQ"}],"key":"ZH5ExPmG16"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"応用例","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"byZp9VHsnz"}],"identifier":"id","label":"応用例","html_id":"id-5","implicit":true,"key":"bVHPVucE6e"},{"type":"heading","depth":3,"position":{"start":{"