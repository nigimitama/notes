lumn":1}},"key":"VtBdTF4YPz"}],"key":"WDjKYhHBJl"}],"key":"tNLbWLgpZ4"},{"type":"listItem","spread":true,"position":{"start":{"line":8,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"paragraph","children":[{"type":"strong","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"Query（クエリ）","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"UaLvs1nnrR"}],"key":"KGF0zA0RHs"},{"type":"text","value":": 値を返すが、状態を変更しない","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"lR1OcfG0xt"}],"key":"KKwFlK0xZC"}],"key":"kTLq06keQG"}],"key":"jJ6Cjf7ss6"},{"type":"code","lang":"python","value":"# CQS原則の例\nclass BankAccount:\n    def __init__(self):\n        self.balance = 0\n    \n    # Command: 状態を変更\n    def deposit(self, amount):\n        self.balance += amount\n        # 値を返さない\n    \n    # Query: 値を返す\n    def get_balance(self):\n        return self.balance\n        # 状態を変更しない","position":{"start":{"line":10,"column":1},"end":{"line":25,"column":1}},"key":"xJkjtj8fg0"}],"key":"mJIj8kB74N"},{"type":"code","lang":"python","value":"# ❌️悪い例：コマンド（変更・書き込み）とクエリ（取得・読み取り）の混在\ndef withdraw(self, amount):\n    self.balance -= amount # 状態変更\n    return self.balance    # 値の返却","position":{"start":{"line":29,"column":1},"end":{"line":34,"column":1}},"key":"N7Pf9LgyO2"}],"key":"HuQ7lDgBm5"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"CQRSの基本構造","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"MEEx5uvELn"}],"identifier":"cqrs","label":"CQRSの基本構造","html_id":"cqrs","implicit":true,"key":"BLt6vId0kZ"},{"type":"code","lang":"","value":"         ┌──────────────────┐\n         │   Application    │\n         └─────┬──────┬─────┘\n               │      │\n        Command│      │Query\n               │      │\n       ┌───────▼──┐  ┌▼──────────┐\n       │ Write    │  │ Read      │\n       │ Model    │  │ Model     │\n       └───────┬──┘  └──┬────────┘\n               │        │\n       ┌───────▼──┐  ┌─▼─────────┐\n       │ Write DB │  │ Read DB   │\n       └──────────┘  └───────────┘","position":{"start":{"line":3,"column":1},"end":{"line":18,"column":1}},"key":"E4PRH6rfUJ"}],"key":"cuxwDVyyXQ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"実装例","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"dqvtARRQyk"}],"identifier":"id","label":"実装例","html_id":"id-1","implicit":true,"key":"u9RrOlDOgH"},{"type":"heading","depth":3,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"シンプルなCQRS","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"UQO3C3VRec"}],"identifier":"id-cqrs","label":"シンプルなCQRS","html_id":"id-cqrs","implicit":true,"key":"NSszrrAUF8"},{"type":"code","lang":"python","value":"# ===== Commands =====\n\nfrom dataclasses import dataclass\n\n@dataclass\nclass CreateOrderCommand:\n    customer_id: str\n    items: list\n\n@dataclass\nclass CancelOrderCommand:\n    order_id: str\n\n# コマンドハンドラー\nclass OrderCommandHandler:\n    def __init__(self, write_repository):\n        self.repository = write_repository\n    \n    def handle_create_order(self, command: CreateOrderCommand):\n        # ビジネスロジック\n        order = Order(\n            customer_id=command.customer_id,\n            items=command.items\n        )\n        \n        # 書き込みモデルに保存\n        self.repository.save(order)\n        \n        # イベント発行（オプション）\n        publish_event(\"OrderCreated\", order)\n    \n    def handle_cancel_order(self, command: CancelOrderCommand):\n        order = self.repository.find_by_id(command.order_id)\n        order.cancel()\n        self.repository.save(order)\n        publish_event(\"OrderCancelled\", order)\n\n# ===== Queries =====\n\n@dataclass\nclass GetOrderQuery:\n    order_id: str\n\n@dataclass\nclass GetCustomerOrdersQuery:\n    customer_id: str\n\n# クエリハンドラー\nclass OrderQueryHandler:\n    def __init__(self, read_repository):\n        self.repository = read_repository\n    \n    def handle_get_order(self, query: GetOrderQuery):\n        # 読み取りモデルから取得\n        return self.repository.find_by_id(query.order_id)\n    \n    def handle_get_customer_orders(self, query: GetCustomerOrdersQuery):\n        # 読み取り専用の最適化されたクエリ\n        return self.repository.find_by_customer(query.customer_id)","position":{"start":{"line":5,"column":1},"end":{"line":65,"column":1}},"key":"INxsNs5EhV"}],"key":"zkYZ7AxczD"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"CQRSの段階","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"dZnrFEKNyF"}],"identifier":"cqrs","label":"CQRSの段階","html_id":"cqrs-1","implicit":true,"key":"bmtHmF4QjU"},{"type":"heading","depth":3,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"レベル1: モデルの分離のみ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"qhycT12SZR"}],"identifier":"id-1","label":"レベル1: モデルの分離のみ","html_id":"id-1-1","implicit":true,"key":"T8QOo5PVyy"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"同じデータベースを使用するが、読み取りと書き込みのモデルを分離。","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"KKrJA2cSs5"}],"key":"q1aJo9l8ca"},{"type":"code","lang":"python","value":"# 書き込みモデル\nclass Order:\n    def __init__(self, customer_id, items):\n        self.customer_id = customer_id\n        self.items = items\n        self.total = sum(item.price for item in items)\n    \n    def add_item(self, item):\n        self.items.append(item)\n        self.total += item.price\n\n# 読み取りモデル（DTO）\nclass OrderSummary:\n    def __init__(self, order_id, customer_name, total, status):\n        self.order_id = order_id\n        self.customer_name = customer_name\n        self.total = total\n        self.status = status","position":{"start":{"line":7,"column":1},"end":{"line":26,"column":1}},"key":"A5Tj5BrQTo"},{"type":"heading","depth":3,"position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"children":[{"type":"text","value":"レベル2: データベースの分離","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"sCQs7IC2En"}],"identifier":"id-2","label":"レベル2: データベースの分離","html_id":"id-2","implicit":true,"key":"S4Yw8tANXD"},{"type":"paragraph","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"読み取りと書き込みで異なるデータベースを使用。","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"if1dIeNOsj"}],"key":"TBkwKVZMY2"},{"type":"code","lang":"python","value":"# 書き込み側: PostgreSQL（正規化されたスキーマ）\nclass WriteOrderRepository:\n    def save(self, order):\n        # トランザクション処理\n        postgres_db.execute(\"\"\"\n            INSERT INTO orders (id, customer_id, total)\n            VALUES (?, ?, ?)\n        \"\"\", order.id, order.customer_id, order.total)\n\n# 読み取り側: MongoDB（非正規化されたスキーマ）\nclass ReadOrderRepository:\n    def find_by_id(self, order_id):\n        # 非正規化されたデータを高速に取得\n        return mongo_db.orders.find_one({\n            \"order_id\": order_id\n        })","position":{"start":{"line":32,"column":1},"end":{"line":49,"column":1}},"key":"uAXJyjx3oP"},{"type":"heading","depth":3,"position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"レベル3: イベントソーシングとの組み合わせ","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"yRQ2aNrpfx"}],"identifier":"id-3","label":"レベル3: イベントソーシングとの組み合わせ","html_id":"id-3","implicit":true,"key":"xJh6X92Jpf"},{"type":"paragraph","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"text","value":"書き込み側でイベントソーシングを使用。","position":{"start":{"line":53,"column":1},"end":{"line":53,"column":1}},"key":"VDejVKbaRi"}],"key":"gfbszt54MU"},{"type":"code","lang":"python","value":"# 書き込み側: イベントストア\nclass EventSourcedOrder:\n    def __init__(self, order_id):\n        self.order_id = order_id\n        self.events = []\n    \n    def create(self, customer_id, items):\n        event = OrderCreatedEvent(self.order_id, customer_id, items)\n        self.apply(event)\n        self.events.append(event)\n    \n    def apply(self, event):\n        if isinstance(event, OrderCreatedEvent):\n            self.customer_id = event.customer_id\n            self.items = event.items\n\n# 読み取り側: プロジェクション\nclass OrderProjection:\n    def handle_order_created(self, event):\n        # イベントから読み取りモデルを構築\n        read_db.insert({\n            \"order_id\": event.order_id,\n            \"customer_id\": event.customer_id,\n            \"items\": event.items,\n            \"total\": sum(item.price for item in event.items)\n        })","position":{"start":{"line":55,"column":1},"end":{"line":82,"column":1}},"key":"m63HOABmSs"}],"key":"TMZ5g6X2su"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"完全な実装例","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"n9sHay1y62"}],"identifier":"id","label":"完全な実装例","html_id":"id-4","implicit":true,"key":"bgVB9bhWys"},{"type":"code","lang":"python","value":"# ===== Domain Events =====\n\nfrom dataclasses import dataclass\nfrom datetime import datetime\n\n@dataclass\nclass OrderCreatedEvent:\n    order_id: str\n    customer_id: str\n    items: list\n    total: float\n    timestamp: datetime\n\n# ===== Write Side =====\n\nclass OrderAggregate:\n    def __init__(self, order_id):\n        self.order_id = order_id\n        self.customer_id = None\n        self.items = []\n        self.total = 0\n        self.uncommitted_events = []\n    \n    def create_order(self, customer_id, items):\n        # ビジネスルール検証\n        if not items:\n            raise ValueError(\"Order must have items\")\n        \n        total = sum(item[\"price\"] for item in items)\n        \n        # イベント生成\n        event = OrderCreatedEvent(\n            order_id=self.order_id,\n            customer_id=customer_id,\n            items=items,\n            total=total,\n            timestamp=datetime.now()\n        )\n        \n        self._apply_event(event)\n        self.uncommitted_events.append(event)\n    \n    def _apply_event(self, event):\n        if isinstance(event, OrderCreatedEvent):\n            self.customer_id = event.customer_id\n            self.items = event.items\n            self.total = event.total\n\nclass OrderWriteRepository:\n    def __init__(self, event_store, event_bus):\n        self.event_store = event_store\n        self.event_bus = event_bus\n    \n    def save(self, aggregate):\n        # イベントストアに保存\n        for event in aggregate.uncommitted_events:\n            self.event_store.append(aggregate.order_id, event)\n            # イベントバスに発行\n            self.event_bus.publish(event)\n        \n        aggregate.uncommitted_events.clear()\n\n# ===== Read Side =====\n\nclass OrderProjectionBuilder:\n    def __init__(self, read_db):\n        self.read_db = read_db\n    \n    def handle(self, event):\n        if isinstance(event, OrderCreatedEvent):\n            # 非正規化されたビューを構築\n            self.read_db.insert({\n                \"order_id\": event.order_id,\n                \"customer_id\": event.customer_id,\n                \"customer_name\": get_customer_name(event.customer_id),\n                \"items_count\": len(event.items),\n                \"total\": event.total,\n                \"created_at\": event.timestamp\n            })\n\nclass OrderReadRepository:\n    def __init__(self, read_db):\n        self.read_db = read_db\n    \n    def find_by_id(self, order_id):\n        return self.read_db.query(\n            \"SELECT * FROM order_view WHERE order_id = ?\",\n            order_id\n        )\n    \n    def find_by_customer(self, customer_id):\n        return self.read_db.query(\n            \"SELECT * FROM order_view WHERE customer_id = ?\",\n            customer_id\n        )\n\n# ===== Application Service =====\n\nclass OrderService:\n    def __init__(self, write_repo, read_repo):\n        self.write_repo = write_repo\n        self.read_repo = read_repo\n    \n    # Command\n    def create_order(self, command: CreateOrderCommand):\n        aggregate = OrderAggregate(generate_id())\n        aggregate.create_order(command.customer_id, command.items)\n        self.write_repo.save(aggregate)\n    \n    # Query\n    def get_order(self, query: GetOrderQuery):\n        return self.read_repo.find_by_id(query.order_id)","position":{"start":{"line":3,"column":1},"end":{"line":116,"column":1}},"key":"eu33jTb8wr"}],"key":"ZdEdfRba6f"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"メリット","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vBaqC79KeP"}],"identifier":"id","label":"メリット","html_id":"id-5","implicit":true,"key":"zPApWiPl6w"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":3,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"strong","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children"