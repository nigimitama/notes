":1}},"key":"piEyBlWO9P"},{"type":"inlineMath","value":"O(n^2)","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>O</mi><mo stretchy=\"false\">(</mo><msup><mi>n</mi><mn>2</mn></msup><mo stretchy=\"false\">)</mo></mrow><annotation encoding=\"application/x-tex\">O(n^2)</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1.0641em;vertical-align:-0.25em;\"></span><span class=\"mord mathnormal\" style=\"margin-right:0.02778em;\">O</span><span class=\"mopen\">(</span><span class=\"mord\"><span class=\"mord mathnormal\">n</span><span class=\"msupsub\"><span class=\"vlist-t\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.8141em;\"><span style=\"top:-3.063em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size6 size3 mtight\"><span class=\"mord mtight\">2</span></span></span></span></span></span></span></span><span class=\"mclose\">)</span></span></span></span>","key":"pbReMpbKxV"},{"type":"text","value":" のままなので、時間計算量全体は変わらない。","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"JGr4bDlMV6"}],"key":"VsNa56XXzx"}],"key":"szn0tQ9Ru8"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from bisect import bisect_left\n\ndef binary_insertion_sort(arr: list) -> list:\n    a = arr.copy()\n    for i in range(1, len(a)):\n        key = a[i]\n        pos = bisect_left(a, key, 0, i)  # 挿入位置を二分探索\n        a[pos + 1:i + 1] = a[pos:i]      # シフト\n        a[pos] = key\n    return a\n\ndata = [5, 3, 8, 1, 4]\nprint(binary_insertion_sort(data))\nassert binary_insertion_sort(data) == sorted(data)","key":"SRdMDmyvCx"},{"type":"outputs","id":"xKw051rCH011Kgx5Kxfth","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"[1, 3, 4, 5, 8]\n"},"children":[],"key":"T1h3K2fTs6"}],"key":"U1ica7N4Ad"}],"key":"UuGEWmMG8L"}],"key":"Yg2q7HR9RP"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"バブルソート","url":"/software-engineering/algorithms/sorting-algorithms/bubble-sort","group":"ソフトウェア工学"},"next":{"title":"選択ソート","url":"/software-engineering/algorithms/sorting-algorithms/selection-sort","group":"ソフトウェア工学"}}},"domain":"http://localhost:3000"}