   if nums[i - 1] and i not in set(primes):\n            primes.append(i)\n    return primes\n\neratosthenes(15)","key":"Z6FWy6HnSl"},{"type":"outputs","id":"-KUuU-JSLW0jz0hpK5Kgv","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":22,"metadata":{},"data":{"text/plain":{"content":"[2, 3, 5, 7, 11, 13]","content_type":"text/plain"}}},"children":[],"key":"oRxJm2NzCe"}],"key":"nFzQyPIiTr"}],"key":"XUWl0V3HYb"}],"key":"ywdSCQIWWf"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"分割統治法","url":"/software-engineering/algorithms/design/divide-and-conquer","group":"ソフトウェア工学"},"next":{"title":"bit演算","url":"/software-engineering/algorithms/bit","group":"ソフトウェア工学"}}},"domain":"http://localhost:3000"}