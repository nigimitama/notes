{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"rkloHcHgZw"}],"key":"FeKxtInmm1"}],"key":"AUdzGQXeMD"},{"type":"listItem","spread":true,"position":{"start":{"line":11,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"最後までtrueだった要素の添字を素数リストに追加して処理終了。","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"H4xUMBlWa8"}],"key":"hUM55HkDOD"}],"key":"JNxmoOJM6X"}],"key":"A2c8yvgC7Y"},{"type":"paragraph","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"text","value":"自分の実装例","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"fly4g0DCHA"}],"key":"r0rJn3zYZr"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"i^2ではなくi*2以上にしている","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"sP00vt1BR5"}],"key":"WVpOxOdAgL"}],"key":"cdZ2utd0OE"}],"key":"uewljVZVvV"}],"visibility":"show","key":"KbJ22XM6no"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import math\n\ndef eratosthenes(x: int) -> list:\n    # 1. 長さxの配列を用意し、1番目の要素にfalseを、2番目以降すべてにtrueを入れる（1は素数ではないため）\n    primes = []\n    nums = [True] * x\n    nums[0] = False\n    # 2. 配列の先頭から順に走査し、trueの要素を見つけたらその添字iを素数リストに追加し、配列のi^2以上のiの倍数番目をfalseにする。\n    for i in range(2, x+1):\n        if nums[i - 1]:\n            primes.append(i)\n            for j in range(i ** 2, x + 1, i):\n                nums[j - 1] = False\n        # 3. 上記の篩い落とし操作を、走査している要素の添字がxの平方根に達するまで行う。\n        # NOTE: 2から√nまでのforループにしてもよい\n        if i >= math.sqrt(x):\n            break\n    # 4. 最後までtrueだった要素の添字を素数リストに追加して処理終了。\n    for i in range(2, x+1):\n        if nums[i - 1] and i not in set(primes):\n            primes.append(i)\n    return primes\n\neratosthenes(15)","key":"vPGHbLBakk"},{"type":"outputs","id":"hgXt0KDDm69kcdbADHcbk","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":22,"metadata":{},"data":{"text/plain":{"content":"[2, 3, 5, 7, 11, 13]","content_type":"text/plain"}}},"children":[],"key":"mf5zAivbi7"}],"key":"N7IOgTikha"}],"key":"QVFhDkaapL"}],"key":"pdS5R7lJnG"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"分割統治法","url":"/software-engineering/algorithms/design/divide-and-conquer","group":"ソフトウェア工学"},"next":{"title":"bit演算","url":"/software-engineering/algorithms/bit","group":"ソフトウェア工学"}}},"domain":"http://localhost:3000"}