,"value":"各ADRは一度書いたら基本的に変更しない（Immutable）。決定が覆った場合は、古いADRを「Superseded」にして、\n新しいADRを追加する形で記録を積み重ねる。番号を振って ","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"lQ75ofrFsT"},{"type":"inlineCode","value":"docs/adr/0001-xxx.md","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"cWJq1b8hb9"},{"type":"text","value":" のように連番ファイルで管理することが多い。","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"y4hkbvksqr"}],"key":"Om8t8y7WW4"}],"key":"Qk8KhHvnIQ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"書くべき判断・書かなくてよい判断","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"bd1EW4jSSK"}],"identifier":"id","label":"書くべき判断・書かなくてよい判断","html_id":"id-2","implicit":true,"key":"ljJFF6al4C"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"書く価値があるのは、覆すコストが高い決定：","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"jQhsuLa1VG"}],"key":"OIajFnYLP2"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":5,"column":1},"end":{"line":9,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"アーキテクチャパターンの選択（","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"fKGje1dT8J"},{"type":"link","url":"/software-engineering/software-architecture/application/layered-architecture","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"レイヤード","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"Z3UyJHnC62"}],"urlSource":"application/layered_architecture.ipynb","dataUrl":"/software-engineering.software-arc