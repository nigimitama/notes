/mo><mo stretchy=\"false\">[</mo><mi>u</mi><mo stretchy=\"false\">]</mo><mo stretchy=\"false\">)</mo></mrow><annotation encoding=\"application/x-tex\">dp[S | (1 &lt;&lt; u)][u] = \\min(dp[S | (1 &lt;&lt; u)][u], \\; dp[S][v] + \\text{cost}[v][u])</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord mathnormal\">d</span><span class=\"mord mathnormal\">p</span><span class=\"mopen\">[</span><span class=\"mord mathnormal\" style=\"margin-right:0.05764em;\">S</span><span class=\"mord\">∣</span><span class=\"mopen\">(</span><span class=\"mord\">1</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">&lt;&lt;</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord mathnormal\">u</span><span class=\"mclose\">)]</span><span class=\"mopen\">[</span><span class=\"mord mathnormal\">u</span><span class=\"mclose\">]</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">=</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mop\">min</span><span class=\"mopen\">(</span><span class=\"mord mathnormal\">d</span><span class=\"mord mathnormal\">p</span><span class=\"mopen\">[</span><span class=\"mord mathnormal\" style=\"margin-right:0.05764em;\">S</span><span class=\"mord\">∣</span><span class=\"mopen\">(</span><span class=\"mord\">1</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">&lt;&lt;</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord mathnormal\">u</span><span class=\"mclose\">)]</span><span class=\"mopen\">[</span><span class=\"mord mathnormal\">u</span><span class=\"mclose\">]</span><span class=\"mpunct\">,</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mspace\" style=\"margin-right:0.1667em;\"></span><span class=\"mord mathnormal\">d</span><span class=\"mord mathnormal\">p</span><span class=\"mopen\">[</span><span class=\"mord mathnormal\" style=\"margin-right:0.05764em;\">S</span><span class=\"mclose\">]</span><span class=\"mopen\">[</span><span class=\"mord mathnormal\" style=\"margin-right:0.03588em;\">v</span><span class=\"mclose\">]</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span><span class=\"mbin\">+</span><span class=\"mspace\" style=\"margin-right:0.2222em;\"></span></span><span class=\"base\"><span class=\"strut\" style=\"height:1em;vertical-align:-0.25em;\"></span><span class=\"mord text\"><span class=\"mord\">cost</span></span><span class=\"mopen\">[</span><span class=\"mord mathnormal\" style=\"margin-right:0.03588em;\">v</span><span class=\"mclose\">]</span><span class=\"mopen\">[</span><span class=\"mord mathnormal\">u</span><span class=\"mclose\">])</span></span></span></span></span>","enumerator":"1","key":"q5wues6y0E"},{"type":"paragraph","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"計算量: O(2^n × n^2)","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"OHKRKbV4mu"}],"key":"IozFHZOOb6"}],"key":"OGhAKCfoNy"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import math\n\ndef tsp(cost: list[list[int]]) -> int:\n    \"\"\"TSP: 全頂点を1度ずつ巡回して0に戻る最小コスト\"\"\"\n    n = len(cost)\n    INF = math.inf\n    # dp[mask][v]: mask の頂点を訪問済みで現在 v にいる最小コスト\n    dp = [[INF] * n for _ in range(1 << n)]\n    dp[1][0] = 0  # 頂点0からスタート（bit 0 が立った状態）\n\n    for S in range(1 << n):\n        for v in range(n):\n            if dp[S][v] == INF:\n                continue\n            if not (S >> v) & 1:\n                continue\n            for u in range(n):\n                if (S >> u) & 1:\n                    continue  # 既訪問\n                nS = S | (1 << u)\n                dp[nS][u] = min(dp[nS][u], dp[S][v] + cost[v][u])\n\n    full = (1 << n) - 1\n    return min(dp[full][v] + cost[v][0] for v in range(1, n))\n\n# 4頂点の例\ncost = [\n    [0, 2, 9, 10],\n    [1, 0, 6,  4],\n    [15, 7, 0, 8],\n    [6, 3, 12, 0],\n]\nprint(f\"TSP最小コスト: {tsp(cost)}\")  # 期待値: 21","key":"KMKazfSiOM"},{"type":"outputs","id":"yJWAZWoLg7nswep0DCW1F","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"TSP最小コスト: 21\n"},"children":[],"key":"n5u6caZjr3"}],"key":"rOUrGOwwdP"}],"key":"WOnu636zfF"}],"key":"t4H8e2neEg"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"数学的なアルゴリズム","url":"/software-engineering/algorithms/mathematic-algorithms","group":"ソフトウェア工学"},"next":{"title":"プログラミング","url":"/software-engineering/programming","group":"ソフトウェア工学"}}},"domain":"http://localhost:3000"}