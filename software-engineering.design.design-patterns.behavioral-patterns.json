},{"type":"inlineCode","value":"if","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"BY3SE7Fmq9"},{"type":"text","value":"/","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"wilIU52gKL"},{"type":"inlineCode","value":"switch","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"xNxhXsJmJ4"},{"type":"text","value":" による状態分岐の乱立を、状態ごとのクラスに置き換える。\nStrategyと構造は似ているが、Stateはオブジェクト自身が状態遷移を管理する点が異なる。","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"KjHtnBSLXl"}],"key":"af17xCJJXP"},{"type":"code","lang":"python","value":"class State:\n    def handle(self, order): raise NotImplementedError\n\nclass PendingState(State):\n    def handle(self, order):\n        print(\"支払い待ち → 発送準備へ\")\n        order.state = ShippedState()\n\nclass ShippedState(State):\n    def handle(self, order):\n        print(\"発送済み → これ以上遷移しない\")\n\nclass Order:\n    def __init__(self):\n        self.state: State = PendingState()\n\n    def proceed(self):\n        self.state.handle(self)\n\norder = Order()\norder.proceed()","position":{"start":{"line":6,"column":1},"end":{"line":28,"column":1}},"key":"RWlt9EHKtL"}],"key":"VcftwzhOuw"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Command","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"eI3djaMUD0"}],"identifier":"command","label":"Command","html_id":"command","implicit":true,"key":"JEpG6biw2m"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"「実行してほしい操作」をオブジェクトとしてカプセル化するパターン。呼び出し元（Invoker）と実行対象（Receiver）を分離でき、\nコマンドのキューイング・ログ記録・Undo/Redoの実装が容易になる。","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"uQUVIa7mei"}],"key":"cbZLryqPJs"},{"type":"code","lang":"python","value":"class Light:\n    def on(self): print(\"light on\")\n    def off(self): print(\"light off\")\n\nclass Command:\n    def execute(self): raise NotImplementedError\n\nclass LightOnCommand(Command):\n    def __init__(self, light):\n        self.light = light\n\n    def execute(self):\n        self.light.on()\n\nclass RemoteControl:\n    def __init__(self):\n        self.history = []\n\n    def submit(self, command: Command):\n        command.execute()\n        self.history.append(command)\n\nremote = RemoteControl()\nremote.submit(LightOnCommand(Light()))","position":{"start":{"line":6,"column":1},"end":{"line":31,"column":1}},"key":"f83l2n5H87"}],"key":"YVakVf2jxm"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Iterator","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"BQyNt4YNVU"}],"identifier":"iterator","label":"Iterator","html_id":"iterator","implicit":true,"key":"vdvSH9sepL"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"集約オブジェクトの内部表現を公開せずに、要素へ順次アクセスする手段を提供するパターン。Pythonでは ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"sL0rN07mep"},{"type":"inlineCode","value":"__iter__","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"KK19pnCTU8"},{"type":"text","value":" /\n","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"FWjHpWmd75"},{"type":"inlineCode","value":"__next__","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"rYAtgRq5l5"},{"type":"text","value":" プロトコルとしてすでに言語仕様に組み込まれており、独自コンテナ型を作るときに自然と使うことになる。","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"vxm1Qb2RFq"}],"key":"D88Zd2gGGT"},{"type":"code","lang":"python","value":"class Range3:\n    def __init__(self, n):\n        self.n = n\n\n    def __iter__(self):\n        self.i = 0\n        return self\n\n    def __next__(self):\n        if self.i >= self.n:\n            raise StopIteration\n        self.i += 1\n        return self.i - 1\n\nfor x in Range3(3):\n    print(x)","position":{"start":{"line":6,"column":1},"end":{"line":23,"column":1}},"key":"G9gNdQEb6L"}],"key":"lgZsJDCWmx"}],"key":"qIhrzuzWa5"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"構造に関するパターン（Structural Patterns）","url":"/software-engineering/design/design-patterns/structural-patterns","group":"ソフトウェア工学"},"next":{"title":"ドメイン駆動設計（DDD）","url":"/software-engineering/design/domain-driven-design","group":"ソフトウェア工学"}}},"domain":"http://localhost:3000"}