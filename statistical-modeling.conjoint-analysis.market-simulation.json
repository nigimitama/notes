":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\nimport pandas as pd\n\nrng = np.random.default_rng(0)\n\nfeature_names = [\"価格::1,000円\", \"価格::1,500円\", \"容量::500ml\", \"ブランド::A社\", \"ブランド::B社\"]\ngamma_true = np.array([1.2, 0.5, -0.3, 0.6, 0.1])   # 母集団平均の部分効用\nsigma_true = np.array([0.5, 0.3, 0.2, 0.4, 0.2])    # 個人差\n\nN_RESP = 100\nbeta_n = gamma_true + rng.normal(0, sigma_true, size=(N_RESP, len(feature_names)))\n\n# シミュレーションしたい競合シナリオ(製品ごとの属性ダミー)\nscenario = pd.DataFrame({\n    \"product\":         [\"自社新製品X\", \"競合A\", \"競合B\", \"競合C\", \"競合D\"],\n    \"価格::1,000円\":     [1, 0, 0, 1, 0],\n    \"価格::1,500円\":     [0, 1, 0, 0, 1],\n    \"容量::500ml\":       [1, 1, 0, 1, 0],\n    \"ブランド::A社\":      [1, 0, 0, 0, 1],\n    \"ブランド::B社\":      [0, 1, 1, 0, 0],\n}).set_index(\"product\")\n\nV = beta_n @ scenario[feature_names].to_numpy().T  # shape: (N_RESP, J)\nscenario\n","key":"Rh0LNigX3z"},{"type":"outputs","id":"aoS98DbHFRXR3yl_Eptjw","children":[],"key":"VaabzrPIYb"}],"key":"YnCz72IxLe"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# (1) ファーストチョイス・ルール\nfirst_choice = np.zeros_like(V)\nfirst_choice[np.arange(N_RESP), V.argmax(axis=1)] = 1\nshare_first_choice = first_choice.mean(axis=0)\n\n# (2) シェア・オブ・プリファレンス・ルール(ロジットルール)\nexp_V = np.exp(V)\nshare_logit = (exp_V / exp_V.sum(axis=1, keepdims=True)).mean(axis=0)\n\n# (3) ランダマイズド・ファーストチョイス(RFC)：ガンベル誤差を加えて多数回試行した平均\nN_SIM = 2000\nrfc_counts = np.zeros(V.shape[1])\nfor _ in range(N_SIM):\n    noisy_V = V + rng.gumbel(size=V.shape)\n    winners = noisy_V.argmax(axis=1)\n    rfc_counts += np.bincount(winners, minlength=V.shape[1])\nshare_rfc = rfc_counts / (N_SIM * N_RESP)\n\npd.DataFrame({\n    \"first_choice\": share_first_choice,\n    \"share_of_preference(logit)\": share_logit,\n    \"RFC\": share_rfc,\n}, index=scenario.index).style.format(\"{:.1%}\")\n","key":"mM3VuLJFmO"},{"type":"outputs","id":"t-MY3xnH_d752bonmVE4L","children":[],"key":"PePe9YNrjH"}],"key":"ryMYuUgOKN"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"ファーストチョイス・ルールは最も極端な（0か1に近い）シェア配分になりやすく、ロジットルールは相対的に均等寄りのシェアを与える。RFCは両者の中間的な結果になる傾向がある。どのルールを採用するかは、実際の市場での「勝者総取り度合い」がどの程度かという業界知識と、ホールドアウトタスク（","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"kcW45OK0nL"},{"type":"link","url":"/statistical-modeling/conjoint-analysis/experimental-design","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"実験計画（属性・水準の設計）","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"MPjctsNt1A"}],"urlSource":"experimental_design.ipynb","dataUrl":"/statistical-modeling.conjoint-analysis.experimental-design.json","internal":true,"protocol":"file","key":"HDvnpkQ9CK"},{"type":"text","value":"、","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"HiVVztSSUB"},{"type":"link","url":"/statistical-modeling/conjoint-analysis/evaluation","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"モデル評価","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"lV0g3pyNpB"}],"urlSource":"evaluation.ipynb","dataUrl":"/statistical-modeling.conjoint-analysis.evaluation.json","internal":true,"protocol":"file","key":"Wle52lOYi7"},{"type":"text","value":"）での予測精度検証によって選ぶ。","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"mtacSbA0nv"}],"key":"oweFnfGzFB"}],"key":"BpkhBzdoUB"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"What-ifシミュレーション","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vw80riP79V"}],"identifier":"what-if","label":"What-ifシミュレーション","html_id":"what-if","implicit":true,"key":"re0W6HWAyM"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"同じ枠組みで、自社製品Xの属性（価格や容量）を変化させたときにシェアがどう変化するかをシミュレーションできる。これにより、価格改定や新機能追加の意思決定を、実際の市場投入前に定量的に評価できる。","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"GNHclhsnGC"}],"key":"R3I7TpjY3a"}],"key":"bFqiMI4c7z"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"def simulate_share(scenario_df, beta_n, rule=\"logit\"):\n    V = beta_n @ scenario_df[feature_names].to_numpy().T\n    if rule == \"logit\":\n        exp_V = np.exp(V)\n        return (exp_V / exp_V.sum(axis=1, keepdims=True)).mean(axis=0)\n    elif rule == \"first_choice\":\n        fc = np.zeros_like(V)\n        fc[np.arange(len(V)), V.argmax(axis=1)] = 1\n        return fc.mean(axis=0)\n\n# 自社新製品Xの価格を1,000円 -> 1,500円に値上げした場合のシェア変化\nscenario_price_up = scenario.copy()\nscenario_price_up.loc[\"自社新製品X\", [\"価格::1,000円\", \"価格::1,500円\"]] = [0, 1]\n\nbefore = simulate_share(scenario, beta_n)\nafter = simulate_share(scenario_price_up, beta_n)\n\npd.DataFrame({\"値上げ前\": before, \"値上げ後\": after}, index=scenario.index).style.format(\"{:.1%}\")\n","key":"dwxAhxbtf9"},{"type":"outputs","id":"_JQ2kw9Vy-34x81ly3c2U","children":[],"key":"wBymCBdPNe"}],"key":"AJjlg8SNoU"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"参考","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"kehMZV7YSb"}],"identifier":"id","label":"参考","html_id":"id-3","implicit":true,"key":"VrMyQSkWSL"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Huber, J., Orme, B., & Miller, C. (1999). Dealing with product similarity in conjoint simulations. ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"GzCvLNC7ug"},{"type":"emphasis","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Sawtooth Software Conference Proceedings","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"lIcxQ5xI14"}],"key":"Mk3tgctIkV"},{"type":"text","value":".","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"AtAx4V1sET"}],"key":"IDyP0v7vpK"}],"key":"YGBEQJ3UeQ"},{"type":"listItem","spread":true,"position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Orme, B. K. (2010). ","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"nZJ6sELMvu"},{"type":"emphasis","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"Getting Started with Conjoint Analysis: Strategies for Product Design and Pricing Research","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"Um3kIy4HtY"}],"key":"y3WWkRtChm"},{"type":"text","value":". Research Publishers LLC.","position":{"start":{"line":4,"column":1},"end":{"line":4,"column":1}},"key":"HZwDWRqjFH"}],"key":"CmvQqrMciq"}],"key":"Nkr50BNWN9"}],"key":"LLXGJO8C2j"}],"key":"orRAdZTeWN"}],"key":"rL3P34N8Su"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"MaxDiff（ベストワーストスケーリング）","url":"/statistical-modeling/conjoint-analysis/maxdiff","group":"統計モデリング"},"next":{"title":"支払意思額（WTP）の推定","url":"/statistical-modeling/conjoint-analysis/willingness-to-pay","group":"統計モデリング"}}},"domain":"http://localhost:3000"}