​.pdf","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"jg5ODAwIJf"}],"urlSource":"https://arxiv.org/pdf/1811.00255.pdf","key":"ftZiHYYNKB"}],"key":"D07HvvqfUw"}],"key":"Amci1wjR7b"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"参考","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"SOeZL22Vz0"}],"identifier":"id","label":"参考","html_id":"id-4","implicit":true,"key":"xVmHtqaKxj"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"link","url":"https://hastie.su.domains/StatLearnSparsity_files/SLS.pdf","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Hastie, T., Tibshirani, R., & Wainwright, M. (2015). Statistical learning with sparsity: the lasso and generalizations. CRC press.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"vb49F8FvTp"}],"urlSource":"https://hastie.su.domains/StatLearnSparsity_files/SLS.pdf","key":"aoA4mDom9l"}],"key":"bwjkx817FA"}],"key":"m2WhCjyIVg"}],"key":"Lw1LmGGGpL"}],"key":"dI9iWdkuJv"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"テキトーにモンテカルロシミュレーション","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"nDqbDbkuV4"}],"identifier":"id","label":"テキトーにモンテカルロシミュレーション","html_id":"id-5","implicit":true,"key":"UfE4uzQrGT"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Lassoは正則化パラメータを強めにかけるとそのぶんバイアスは入る","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"uaNxGWoQz0"}],"key":"te4hmrSOzt"}],"key":"Bf6mT5Bcxg"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\nfrom sklearn.linear_model import Lasso, LinearRegression\nfrom sklearn.metrics import mean_squared_error, r2_score\nimport matplotlib.pyplot as plt\n\ntrue_coefs = np.array([0.01, 0.1, 0.3, 0.5, 0.9, 1])\n\ndef gen_data(n = 300, seed = 0):\n    np.random.seed(seed)\n    d = len(true_coefs)\n    X = np.random.uniform(0, 1, size=(n, d))\n    X[:, 0] = 1\n    y = X @ true_coefs + np.random.normal(size=n, scale=1)\n    return X, y\n\n\nols_coefs = []\nalphas = [0.01, 0.005]\nn_alpha = len(alphas)\nlasso_coefs_list = []\nfor _ in range(n_alpha):\n    lasso_coefs_list.append([])\n\nn_trial = 500\nfor k in range(n_trial):\n    X, y = gen_data(seed=k)\n\n    for l in range(n_alpha):\n        lasso = Lasso(alpha=alphas[l])\n        lasso.fit(X, y)\n        lasso_coefs_list[l].append(lasso.coef_)\n\n    ols = LinearRegression()\n    ols.fit(X, y)\n    ols_coefs.append(ols.coef_)\n\nfor i in range(n_alpha):\n    lasso_coefs_list[i] = np.array(lasso_coefs_list[i])\nols_coefs = np.array(ols_coefs)","key":"ZOe7T8AGSb"},{"type":"outputs","id":"xXeOeZ_04dZCrS8kaWt97","children":[],"key":"SYD9c7sfQy"}],"key":"JIBioojfhD"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"n_features = ols_coefs.shape[1]\ncol_idx = 0\nncols = 2\nnrows = int(np.ceil(n_features / ncols))\n\nfig, axes = plt.subplots(figsize=[ncols * 4, nrows * 3], ncols=ncols, nrows=nrows)\nfig.subplots_adjust(hspace=0.5)\naxes = axes.flatten()\nfor col_idx in range(n_features):\n    axes[col_idx].hist(ols_coefs[:, col_idx], bins=50, label=\"OLS\", alpha=0.5)\n    for l in range(n_alpha):\n        lasso_coefs = lasso_coefs_list[l]\n        axes[col_idx].hist(lasso_coefs[:, col_idx], bins=50, label=fr\"Lasso $\\alpha={alphas[l]}$\", alpha=0.5)\n    axes[col_idx].set(xlabel=fr\"$\\hat\\beta_{col_idx}$\", title=fr\"$\\hat\\beta_{col_idx}$ (true $\\beta_{col_idx}$={true_coefs[col_idx]})\")\n    axes[col_idx].legend()\n# fig.suptitle(f\"lasso alpha={alpha}\")\nfig.show()","key":"IgvGI4iFtF"},{"type":"outputs","id":"NXYGQNI80d8deGW8ROWXV","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"196207234cb8b933b28692d8fe2df9c7","path":"/notes/build/196207234cb8b933b28692d8fe2df9c7.png"},"text/plain":{"content":"<Figure size 800x900 with 6 Axes>","content_type":"text/plain"}}},"children":[],"key":"xkifb9SIkJ"}],"key":"Xrq0PywT9D"}],"key":"HGF0RKSswQ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from scipy.stats import norm, gaussian_kde\n\ndef kdeplot(data, ax, label=None):\n    try:\n        kde = gaussian_kde(data)\n        x = np.linspace(data.min(), data.max(), 100)\n        y = kde.evaluate(x)\n        ax.plot(x, y, label=label, alpha=0.7)\n    except:\n        pass\n    return ax\n\nn_features = ols_coefs.shape[1]\ncol_idx = 0\nncols = 2\nnrows = int(np.ceil(n_features / ncols))\n\nfig, axes = plt.subplots(figsize=[ncols * 4, nrows * 3], ncols=ncols, nrows=nrows)\nfig.subplots_adjust(hspace=0.5)\naxes = axes.flatten()\nfor col_idx in range(n_features):\n    kdeplot(ols_coefs[:, col_idx], ax=axes[col_idx], label=\"OLS\")\n    for l in range(n_alpha):\n        lasso_coefs = lasso_coefs_list[l]\n        kdeplot(lasso_coefs[:, col_idx], ax=axes[col_idx], label=fr\"Lasso $\\alpha={alphas[l]}$\")\n\n    axes[col_idx].set(xlabel=fr\"$\\hat\\beta_{col_idx}$\", title=fr\"$\\hat\\beta_{col_idx}$ (true $\\beta_{col_idx}$={true_coefs[col_idx]})\")\n    axes[col_idx].legend()\n# fig.suptitle(f\"lasso alpha={alpha}\")\nfig.show()","key":"T23p9CIPG1"},{"type":"outputs","id":"pGxstmx2q68ySuSEHCNNT","children":[{"type":"output","jupyter_data":{"name":"stderr","output_type":"stream","text":"No artists with labels found to put in legend.  Note that artists whose label start with an underscore are ignored when legend() is called with no argument.\n"},"children":[],"key":"ewT7mqhkpw"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"e7e01dd877379f1ffa6a9cae37d1d6f1","path":"/notes/build/e7e01dd877379f1ffa6a9cae37d1d6f1.png"},"text/plain":{"content":"<Figure size 800x900 with 6 Axes>","content_type":"text/plain"}}},"children":[],"key":"IYZHNDXJez"}],"key":"oOKSvfwT39"}],"key":"hzcG9N7zi9"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"aOM1uOneJf"},{"type":"outputs","id":"8XDCx7T6CC-ty7tHlHtzE","children":[],"key":"VHGEoVPzrH"}],"key":"MapzC3sV90"}],"key":"WYQJn4GFBl"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Ridge回帰","url":"/machine-learning/linear-models/regression/ridge-regression","group":"機械学習"},"next":{"title":"線形判別モデル","url":"/machine-learning/linear-models/classification/linear-discriminant-analysis","group":"機械学習"}}},"domain":"http://localhost:3000"}