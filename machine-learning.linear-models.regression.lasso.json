そのぶんバイアスは入る","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"X6JE4hvKdy"}],"key":"tHGGMvlD5z"}],"key":"CHjrrU7Eby"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\nfrom sklearn.linear_model import Lasso, LinearRegression\nfrom sklearn.metrics import mean_squared_error, r2_score\nimport matplotlib.pyplot as plt\n\ntrue_coefs = np.array([0.01, 0.1, 0.3, 0.5, 0.9, 1])\n\ndef gen_data(n = 300, seed = 0):\n    np.random.seed(seed)\n    d = len(true_coefs)\n    X = np.random.uniform(0, 1, size=(n, d))\n    X[:, 0] = 1\n    y = X @ true_coefs + np.random.normal(size=n, scale=1)\n    return X, y\n\n\nols_coefs = []\nalphas = [0.01, 0.005]\nn_alpha = len(alphas)\nlasso_coefs_list = []\nfor _ in range(n_alpha):\n    lasso_coefs_list.append([])\n\nn_trial = 500\nfor k in range(n_trial):\n    X, y = gen_data(seed=k)\n\n    for l in range(n_alpha):\n        lasso = Lasso(alpha=alphas[l])\n        lasso.fit(X, y)\n        lasso_coefs_list[l].append(lasso.coef_)\n\n    ols = LinearRegression()\n    ols.fit(X, y)\n    ols_coefs.append(ols.coef_)\n\nfor i in range(n_alpha):\n    lasso_coefs_list[i] = np.array(lasso_coefs_list[i])\nols_coefs = np.array(ols_coefs)","key":"lDlczCoLa8"},{"type":"outputs","id":"Qgw61rUyCPQP2-ZVYYdb0","children":[],"key":"KjBPQv5IyY"}],"key":"ch11AT19HU"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"n_features = ols_coefs.shape[1]\ncol_idx = 0\nncols = 2\nnrows = int(np.ceil(n_features / ncols))\n\nfig, axes = plt.subplots(figsize=[ncols * 4, nrows * 3], ncols=ncols, nrows=nrows)\nfig.subplots_adjust(hspace=0.5)\naxes = axes.flatten()\nfor col_idx in range(n_features):\n    axes[col_idx].hist(ols_coefs[:, col_idx], bins=50, label=\"OLS\", alpha=0.5)\n    for l in range(n_alpha):\n        lasso_coefs = lasso_coefs_list[l]\n        axes[col_idx].hist(lasso_coefs[:, col_idx], bins=50, label=fr\"Lasso $\\alpha={alphas[l]}$\", alpha=0.5)\n    axes[col_idx].set(xlabel=fr\"$\\hat\\beta_{col_idx}$\", title=fr\"$\\hat\\beta_{col_idx}$ (true $\\beta_{col_idx}$={true_coefs[col_idx]})\")\n    axes[col_idx].legend()\n# fig.suptitle(f\"lasso alpha={alpha}\")\nfig.show()","key":"Tv6sK3Cnpa"},{"type":"outputs","id":"z9cOqLpOzV5pox3e70ROk","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"196207234cb8b933b28692d8fe2df9c7","path":"/notes/build/196207234cb8b933b28692d8fe2df9c7.png"},"text/plain":{"content":"<Figure size 800x900 with 6 Axes>","content_type":"text/plain"}}},"children":[],"key":"ZmlaHm3eBZ"}],"key":"DuP5tWZXVY"}],"key":"KUpjLfqP7Z"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from scipy.stats import norm, gaussian_kde\n\ndef kdeplot(data, ax, label=None):\n    try:\n        kde = gaussian_kde(data)\n        x = np.linspace(data.min(), data.max(), 100)\n        y = kde.evaluate(x)\n        ax.plot(x, y, label=label, alpha=0.7)\n    except:\n        pass\n    return ax\n\nn_features = ols_coefs.shape[1]\ncol_idx = 0\nncols = 2\nnrows = int(np.ceil(n_features / ncols))\n\nfig, axes = plt.subplots(figsize=[ncols * 4, nrows * 3], ncols=ncols, nrows=nrows)\nfig.subplots_adjust(hspace=0.5)\naxes = axes.flatten()\nfor col_idx in range(n_features):\n    kdeplot(ols_coefs[:, col_idx], ax=axes[col_idx], label=\"OLS\")\n    for l in range(n_alpha):\n        lasso_coefs = lasso_coefs_list[l]\n        kdeplot(lasso_coefs[:, col_idx], ax=axes[col_idx], label=fr\"Lasso $\\alpha={alphas[l]}$\")\n\n    axes[col_idx].set(xlabel=fr\"$\\hat\\beta_{col_idx}$\", title=fr\"$\\hat\\beta_{col_idx}$ (true $\\beta_{col_idx}$={true_coefs[col_idx]})\")\n    axes[col_idx].legend()\n# fig.suptitle(f\"lasso alpha={alpha}\")\nfig.show()","key":"l203HYgh9s"},{"type":"outputs","id":"g0LyL1h4ATzdhnwq9ZP8l","children":[{"type":"output","jupyter_data":{"name":"stderr","output_type":"stream","text":"No artists with labels found to put in legend.  Note that artists whose label start with an underscore are ignored when legend() is called with no argument.\n"},"children":[],"key":"ObfGoNpCGC"},{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"e7e01dd877379f1ffa6a9cae37d1d6f1","path":"/notes/build/e7e01dd877379f1ffa6a9cae37d1d6f1.png"},"text/plain":{"content":"<Figure size 800x900 with 6 Axes>","content_type":"text/plain"}}},"children":[],"key":"Z95LDc15UI"}],"key":"A0O0Xq2ZKD"}],"key":"XygyOrZw5R"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"","key":"dEu9NRp9yG"},{"type":"outputs","id":"My_HxUjJLSRBYdW0CZszR","children":[],"key":"q2LOoXz6lc"}],"key":"rjBQ217XCt"}],"key":"tCFCmwtdWz"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Ridge回帰","url":"/machine-learning/linear-models/regression/ridge-regression","group":"機械学習"},"next":{"title":"線形判別モデル","url":"/machine-learning/linear-models/classification/linear-discriminant-analysis","group":"機械学習"}}},"domain":"http://localhost:3000"}