:3,"column":1},"end":{"line":3,"column":1}},"key":"ldCMAhJIJI"},{"type":"text","value":" だけ進める場合に、位置 ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"uxBtFoJMEF"},{"type":"inlineCode","value":"0","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ZHd2aXFUbC"},{"type":"text","value":" から位置 ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"skTzCUjpNu"},{"type":"inlineCode","value":"n","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"bwtgKsXx0j"},{"type":"text","value":" まで最短何ステップかかるか。","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"tCdUOpMJ7J"}],"key":"h9VVDtMKb3"}],"key":"mn5vXgs3kG"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from collections import deque\n\ndef min_steps(goal):\n    queue = deque([(0, 0)])  # (現在地, ステップ数)\n    visited = {0}\n\n    while queue:\n        pos, steps = queue.popleft()\n        if pos == goal:\n            return steps\n        for next_pos in [pos + 1, pos + 2]:\n            if next_pos <= goal and next_pos not in visited:\n                visited.add(next_pos)\n                queue.append((next_pos, steps + 1))\n\nprint(min_steps(5))   # 3  (0→2→4→5)\nprint(min_steps(10))  # 5  (0→2→4→6→8→10)","key":"lO9OUohblO"},{"type":"outputs","id":"4J-ugClzhxfm6HqkOdj-N","children":[],"key":"HLMnRGJQQL"}],"key":"L20zjgXKTn"}],"key":"bVEtDlOcjg"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"スタック","url":"/software-engineering/algorithms/data-structures/stack","group":"ソフトウェア工学"},"next":{"title":"優先度付きキュー","url":"/software-engineering/algorithms/data-structures/priority-queue","group":"ソフトウェア工学"}}},"domain":"http://localhost:3000"}