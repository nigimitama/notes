:3,"column":1},"end":{"line":3,"column":1}},"key":"xwJQtd0v8O"},{"type":"text","value":" だけ進める場合に、位置 ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"JE4j08TZyj"},{"type":"inlineCode","value":"0","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"mhbZ2TpfcP"},{"type":"text","value":" から位置 ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"whrQvHBh9q"},{"type":"inlineCode","value":"n","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"zcZsN7oXTe"},{"type":"text","value":" まで最短何ステップかかるか。","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"UdZLOYYGzF"}],"key":"gHnHbZ6QzR"}],"key":"oLUn2atkX0"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"from collections import deque\n\ndef min_steps(goal):\n    queue = deque([(0, 0)])  # (現在地, ステップ数)\n    visited = {0}\n\n    while queue:\n        pos, steps = queue.popleft()\n        if pos == goal:\n            return steps\n        for next_pos in [pos + 1, pos + 2]:\n            if next_pos <= goal and next_pos not in visited:\n                visited.add(next_pos)\n                queue.append((next_pos, steps + 1))\n\nprint(min_steps(5))   # 3  (0→2→4→5)\nprint(min_steps(10))  # 5  (0→2→4→6→8→10)","key":"cMgrYt2EgM"},{"type":"outputs","id":"9V4bAZLb5htyqM3aZQvA4","children":[],"key":"I59t1qI2np"}],"key":"UhG0BwQmKa"}],"key":"Sw4h98vn3R"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"スタック","url":"/software-engineering/algorithms/data-structures/stack","group":"ソフトウェア工学"},"next":{"title":"優先度付きキュー","url":"/software-engineering/algorithms/data-structures/priority-queue","group":"ソフトウェア工学"}}},"domain":"http://localhost:3000"}