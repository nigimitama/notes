dx_eff)\n    return dy, x + dx, y - dy\n\n\ndef swap_y_for_x(x, y, dy, fee=0.003):\n    dx, y2, x2 = swap_x_for_y(y, x, dy, fee)\n    return dx, x2, y2\n\n\n# ETH/USDC プール（X=USDC, Y=ETH）、ETH価格 = 2000 USDC\nx0, y0 = 20_000_000.0, 10_000.0\nvictim_usdc = 500_000\n\n# 攻撃がない場合\neth_fair, _, _ = swap_x_for_y(x0, y0, victim_usdc)\n\n# サンドイッチ攻撃\nattacker_usdc = 1_000_000\neth_atk, x1, y1 = swap_x_for_y(x0, y0, attacker_usdc)  # フロントラン\neth_victim, x2, y2 = swap_x_for_y(x1, y1, victim_usdc)  # 被害者\nusdc_back, x3, y3 = swap_y_for_x(x2, y2, eth_atk)  # バックラン\n\nprint(f\"被害者が受け取るETH: 攻撃なし {eth_fair:.2f} → 攻撃あり {eth_victim:.2f}（{(1 - eth_victim / eth_fair) * 100:.2f}% 減）\")\nprint(f\"攻撃者の利益: {usdc_back - attacker_usdc:,.0f} USDC（gas代・チップを除く）\")","key":"sZmcVuR6xy"},{"type":"outputs","id":"kXUMe7OXGnjsIqzJ5bmGa","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"被害者が受け取るETH: 攻撃なし 243.19 → 攻撃あり 220.87（9.18% 減）\n攻撃者の利益: 40,961 USDC（gas代・チップを除く）\n"},"children":[],"key":"v5MpmODfSN"}],"key":"HdegBFGfny"}],"key":"xbzGrCgdsD"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"スリッページ許容範囲を小さく設定すれば、価格が大きく動いたときにスワップが失敗するので被害を抑えられるが、通常の値動きでも失敗しやすくなる。","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"YFLYin1BSG"}],"key":"P3fjNtCFNA"}],"key":"XjMccbcGc6"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"PBSとMEV-Boost","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"k0Uhh8g2AQ"}],"identifier":"pbs-mev-boost","label":"PBSとMEV-Boost","html_id":"pbs-mev-boost","implicit":true,"key":"pnnk9UrGyt"},{"type":"heading","depth":3,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"MEV