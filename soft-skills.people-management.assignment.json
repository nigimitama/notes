品をプレゼンをする予定なんだけど、今年一番の大きな契約につながるかもしれない重要な提案なんだ。クライアントにとっても絶対に役に立つ商品だと思うから、ここでしっかり商品のよさを伝えておきたい。\n商品Aをアピールするために、市場での評価やランキングなど、お客様に訴求するデータを集めておいてくれないかな。よろしく頼むね","position":{"start":{"line":13,"column":1},"end":{"line":13,"column":1}},"key":"dmTxDLuAnV"}],"key":"lu9xI5BJ12"}],"key":"qCs0opq5SX"}],"key":"aXIhi68oI7"}],"key":"dWWyuoqptm"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"任せた仕事ではメンバー自身が決断する機会を必ず入れるようにする","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Q1qv0iuOLy"}],"identifier":"id","label":"任せた仕事ではメンバー自身が決断する機会を必ず入れるようにする","html_id":"id-3","implicit":true,"key":"df4OXpBUqL"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"例えば資料作成で「どんなレイアウトにすればいいですか？」と訊かれたら、「まずは自分で考えてみてください」と自分で決めさせる（誰向けなのか、何を伝えるのかなどは共有してるor質問していい前提）。\nこうすることでメンバー自身がプレゼンの内容や聴衆を考えて、成長につながる経験になる。","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Dw1XUAHBFV"}],"key":"hnINtS1Q35"},{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"「どうすればいいですか？」→「逆にあなたはどうすればいいと思う？」を重ねていく","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"hG1fkichGF"}],"key":"bN2f0ulR6S"},{"type":"paragraph","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"メンバーが自分で考える機会を持つことで自律的に動けるように成長していき、長期的にはリーダーがより本質的な仕事に集中できるようになる","position":{"start":{"line":8,"column":1},"end":{"line":8,"column":1}},"key":"QGvwWdeKNo"}],"key":"X7PlhZbXea"}],"key":"Xc8cjVZubg"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"仕事を任せたらチェックポイントで確認して事故を未然に防ぐ","position":{"start":{"line":1