n range(N): # 全部順番にみていく\n        if arr[i] == target: # targetを発見したらindexを返す\n            return i\n    return -1 # 見つからなかった場合","key":"BrHH48qVkw"},{"type":"outputs","id":"FL7Y8erMMJRBm5THnqrI5","children":[],"key":"CgBwO1Vf6E"}],"key":"P1wNx8Cfx8"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"linear_search(arr=[1, 5, 3, 2, 4], target=3)","visibility":"show","key":"IIctsLEgRB"},{"type":"outputs","id":"xVFNe9Y2QbLiEH8NRITAj","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":23,"metadata":{},"data":{"text/plain":{"content":"2","content_type":"text/plain"}}},"children":[],"key":"m9giswuYeX"}],"visibility":"show","key":"VCtbFF3VqY"}],"visibility":"show","key":"DkmhMXkQTc"}],"key":"X5HW2VGxrB"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"探索アルゴリズム","url":"/software-engineering/algorithms/search-algorithms","group":"ソフトウェア工学"},"next":{"title":"二分探索","url":"/software-engineering/algorithms/search-algorithms/binary-search","group":"ソフトウェア工学"}}},"domain":"http://localhost:3000"}