n range(N): # 全部順番にみていく\n        if arr[i] == target: # targetを発見したらindexを返す\n            return i\n    return -1 # 見つからなかった場合","key":"LSGPmNsMhi"},{"type":"outputs","id":"ixtFH2zIpM3m-SZhFjKMq","children":[],"key":"NAnwXYIEEp"}],"key":"SolRKRjQgQ"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"linear_search(arr=[1, 5, 3, 2, 4], target=3)","visibility":"show","key":"T0RzFzM7HS"},{"type":"outputs","id":"0gCQ47A3oB2KAJAQ8y2JE","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":23,"metadata":{},"data":{"text/plain":{"content":"2","content_type":"text/plain"}}},"children":[],"key":"EWHE9Lq40e"}],"visibility":"show","key":"iw26PZFH7M"}],"visibility":"show","key":"cH6j9stFfq"}],"key":"hdgO6xYmMZ"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"探索アルゴリズム","url":"/software-engineering/algorithms/search-algorithms","group":"ソフトウェア工学"},"next":{"title":"二分探索","url":"/software-engineering/algorithms/search-algorithms/binary-search","group":"ソフトウェア工学"}}},"domain":"http://localhost:3000"}