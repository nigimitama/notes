n range(N): # 全部順番にみていく\n        if arr[i] == target: # targetを発見したらindexを返す\n            return i\n    return -1 # 見つからなかった場合","key":"psFqsbgemh"},{"type":"outputs","id":"IlP8b0KYhKtB9eQPzBwRX","children":[],"key":"AOyFsAmwnL"}],"key":"cCU4KBGFAd"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"linear_search(arr=[1, 5, 3, 2, 4], target=3)","visibility":"show","key":"VBqNKKRSpX"},{"type":"outputs","id":"CD223rVGy1MCRwiR4ABAm","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":23,"metadata":{},"data":{"text/plain":{"content":"2","content_type":"text/plain"}}},"children":[],"key":"lOtJOAXsjH"}],"visibility":"show","key":"YLypwq2k2F"}],"visibility":"show","key":"cK9pKkWK4w"}],"key":"FIhBG0ytr3"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"探索アルゴリズム","url":"/software-engineering/algorithms/search-algorithms","group":"ソフトウェア工学"},"next":{"title":"二分探索","url":"/software-engineering/algorithms/search-algorithms/binary-search","group":"ソフトウェア工学"}}},"domain":"http://localhost:3000"}