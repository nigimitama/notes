n range(N): # 全部順番にみていく\n        if arr[i] == target: # targetを発見したらindexを返す\n            return i\n    return -1 # 見つからなかった場合","key":"SssAsr8bLO"},{"type":"outputs","id":"ffsA4FbZPBMxJ3A47fpNY","children":[],"key":"OMfAX8Y7vI"}],"key":"VKuUChyxeI"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"linear_search(arr=[1, 5, 3, 2, 4], target=3)","visibility":"show","key":"a9Ssupl9sF"},{"type":"outputs","id":"Z6NGd3XBwf7St47C8_PsE","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":23,"metadata":{},"data":{"text/plain":{"content":"2","content_type":"text/plain"}}},"children":[],"key":"b4XvA9OO2i"}],"visibility":"show","key":"P5I8xYfQ0u"}],"visibility":"show","key":"Kys0Yqis8O"}],"key":"o2vbUAlwUI"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"探索アルゴリズム","url":"/software-engineering/algorithms/search-algorithms","group":"ソフトウェア工学"},"next":{"title":"二分探索","url":"/software-engineering/algorithms/search-algorithms/binary-search","group":"ソフトウェア工学"}}},"domain":"http://localhost:3000"}