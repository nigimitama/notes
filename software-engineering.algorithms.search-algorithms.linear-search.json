n range(N): # 全部順番にみていく\n        if arr[i] == target: # targetを発見したらindexを返す\n            return i\n    return -1 # 見つからなかった場合","key":"goIgSIpHF2"},{"type":"outputs","id":"Ka28EtSx3ai2ciI3UO7B8","children":[],"key":"KaPwaA2EZt"}],"key":"VkRMb10CMB"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"linear_search(arr=[1, 5, 3, 2, 4], target=3)","visibility":"show","key":"uUjRleVTto"},{"type":"outputs","id":"XyfvOY0u25rjC8VxdJm_K","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":23,"metadata":{},"data":{"text/plain":{"content":"2","content_type":"text/plain"}}},"children":[],"key":"UeZ6K5dr68"}],"visibility":"show","key":"A20jwo4Bsz"}],"visibility":"show","key":"BoHJnKHmtG"}],"key":"FDA3k7VS48"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"探索アルゴリズム","url":"/software-engineering/algorithms/search-algorithms","group":"ソフトウェア工学"},"next":{"title":"二分探索","url":"/software-engineering/algorithms/search-algorithms/binary-search","group":"ソフトウェア工学"}}},"domain":"http://localhost:3000"}