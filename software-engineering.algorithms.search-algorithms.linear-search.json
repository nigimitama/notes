n range(N): # 全部順番にみていく\n        if arr[i] == target: # targetを発見したらindexを返す\n            return i\n    return -1 # 見つからなかった場合","key":"UDlcLt0FMg"},{"type":"outputs","id":"51U4zLGwXlK7feQ8ee1Vq","children":[],"key":"v1Ye1mhoM1"}],"key":"FFzdFXSJLR"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"linear_search(arr=[1, 5, 3, 2, 4], target=3)","visibility":"show","key":"Nfx2x9aCX3"},{"type":"outputs","id":"OAMWYVMeXNcFdgWLicCk0","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":23,"metadata":{},"data":{"text/plain":{"content":"2","content_type":"text/plain"}}},"children":[],"key":"PBYiqlmGg7"}],"visibility":"show","key":"KwzPaNVMrR"}],"visibility":"show","key":"e4WparJESg"}],"key":"c8n19AOg3w"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"探索アルゴリズム","url":"/software-engineering/algorithms/search-algorithms","group":"ソフトウェア工学"},"next":{"title":"二分探索","url":"/software-engineering/algorithms/search-algorithms/binary-search","group":"ソフトウェア工学"}}},"domain":"http://localhost:3000"}