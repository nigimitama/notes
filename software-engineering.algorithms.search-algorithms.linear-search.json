n range(N): # 全部順番にみていく\n        if arr[i] == target: # targetを発見したらindexを返す\n            return i\n    return -1 # 見つからなかった場合","key":"bwtuUuHsBB"},{"type":"outputs","id":"H25rr1K77phRoNsLuZF5Q","children":[],"key":"mOpMlNi6dA"}],"key":"N0MqFi1BIa"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"linear_search(arr=[1, 5, 3, 2, 4], target=3)","visibility":"show","key":"WRwQfymbut"},{"type":"outputs","id":"8o7O8_YCBf3w8EjxjkRCt","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":23,"metadata":{},"data":{"text/plain":{"content":"2","content_type":"text/plain"}}},"children":[],"key":"RIJHvfZtYb"}],"visibility":"show","key":"rzqwSsSK6G"}],"visibility":"show","key":"ao3o0XSmY1"}],"key":"FOSZbR5Ka5"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"探索アルゴリズム","url":"/software-engineering/algorithms/search-algorithms","group":"ソフトウェア工学"},"next":{"title":"二分探索","url":"/software-engineering/algorithms/search-algorithms/binary-search","group":"ソフトウェア工学"}}},"domain":"http://localhost:3000"}