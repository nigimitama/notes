\n\n        # 中央の値が target より大きい場合\n        else:\n            # target は中央より左側にあるはずなので、範囲の右端を mid - 1 にずらす\n            right = mid - 1\n\n    # 探索範囲がなくなっても見つからなかった（arrにtargetが含まれない）場合\n    return -1","key":"jJUKFwZPGB"},{"type":"outputs","id":"FLjtSiOxY4ioaGIwirYOv","children":[],"key":"iwO2Diwz1l"}],"key":"mTDoHxxYXr"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"numbers = [1, 3, 5, 7, 9, 11, 13]\nbinary_search(numbers, 7)","key":"CMYrFG50Yh"},{"type":"outputs","id":"udjcKOTAAb1hMGzzyxfWS","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":11,"metadata":{},"data":{"text/plain":{"content":"7","content_type":"text/plain"}}},"children":[],"key":"RAs8xvhrUi"}],"key":"HKZYEjejGB"}],"key":"itadz3Zg0O"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"関連：bisectパッケージ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"azQsK0p70R"}],"identifier":"id-bisect","label":"関連：bisectパッケージ","html_id":"id-bisect","implicit":true,"key":"AeMNcGt88J"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Pythonの標準パッケージ ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"sqIXPYoNwk"},{"type":"inlineCode","value":"bisect","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"TKaWCaZE2J"},{"type":"text","value":" は二分探索で実装されている","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"tJKDB909Wt"}],"key":"pxk3WqDws1"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"link","url":"https://docs.python.org/ja/3/library/bisect.html","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"typ