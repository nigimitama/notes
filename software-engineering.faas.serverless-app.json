n":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"htKYXa649V"}],"key":"ogb2YWK20G"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"link","url":"https://docs.aws.amazon.com/ja_jp/lambda/latest/dg/powertools-for-lambda.html","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Powertools for AWS Lambda - AWS Lambda","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"ydlhON5vZP"}],"urlSource":"https://docs.aws.amazon.com/ja_jp/lambda/latest/dg/powertools-for-lambda.html","key":"CR1Zr0I8jK"}],"key":"ARhYFfmJo1"},{"type":"details","children":[{"type":"summary","children":[{"type":"text","value":"コード例","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"zsiagsy5LF"}],"key":"bXKf38RHuF"},{"type":"code","lang":"python","value":"from typing import List\nimport requests\nfrom pydantic import BaseModel, Field\nfrom aws_lambda_powertools import Logger, Tracer\nfrom aws_lambda_powertools.event_handler import APIGatewayRestResolver\nfrom aws_lambda_powertools.utilities.typing import LambdaContext\n\ntracer = Tracer()\nlogger = Logger()\napp = APIGatewayRestResolver(enable_validation=True)\napp.enable_swagger(path=\"/swagger\")  # OpenAPI仕様書 \n\nclass Todo(BaseModel):  # Pydanticによる型定義とバリデーション\n    userId: int\n    id_: int = Field(alias=\"id\")\n    title: str\n    completed: bool\n\n\n@app.post(\"/todos\") # POST /todos へのルーティング\ndef create_todo(todo: Todo) -> str:\n    response = requests.post(\"https://jsonplaceholder.typicode.com/todos\", json=todo.dict(by_alias=True))\n    response.raise_for_status()\n    return response.json()[\"id\"]\n\n\n@app.get(\"/todos\") # GET /todos へのルーティング\ndef get_todos() -> List[Todo]:\n    todo = requests.get(\"https://jsonplaceholder.typicode.com/todos\")\n    todo.raise_for_status()\n    return todo.json()\n\n\ndef lambda_handler(event: dict, context: LambdaContext) -> dict:\n    return app.resolve(event, context)","position":{"start":{"line":9,"column":1},"end":{"line":45,"column":1}},"key":"bBCWeDmkrK"},{"type":"paragraph","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"link","url":"https://docs.aws.amazon.com/powertools/python/latest/core/event_handler/openapi/#swagger-ui","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"https://​docs​.aws​.amazon​.com​/powertools​/python​/latest​/core​/event​_handler​/openapi​/​#swagger​-ui","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"he55UegfRG"}],"urlSource":"https://docs.aws.amazon.com/powertools/python/latest/core/event_handler/openapi/#swagger-ui","key":"QWGS4YVrJh"},{"type":"text","value":" をもとに作成","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"f9GUza2XSe"}],"key":"KjlOWRn39R"}],"key":"MtM4eMrdVM"}],"key":"XFav6CQEJV"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"aws-lambda-web-adapter","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"MCyv5HhAIo"}],"identifier":"aws-lambda-web-adapter","label":"aws-lambda-web-adapter","html_id":"aws-lambda-web-adapter","implicit":true,"key":"Nqm6zoywJR"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"aws-lambda-web-adapterを挟むことでLambda独自のイベント形式が変換され、標準的なWeb App Frameworkが使えるようになる。","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"gKypYUt9cv"}],"key":"kqUuQ7Jkic"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"link","url":"https://github.com/aws/aws-lambda-web-adapter","position":{"start":{"line":5,"column":1},"end":{"line":5,"co