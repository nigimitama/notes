bdaContext) -> dict:\n    return app.resolve(event, context)","position":{"start":{"line":9,"column":1},"end":{"line":45,"column":1}},"key":"pRCrUUnLYQ"},{"type":"paragraph","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"link","url":"https://docs.aws.amazon.com/powertools/python/latest/core/event_handler/openapi/#swagger-ui","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"https://​docs​.aws​.amazon​.com​/powertools​/python​/latest​/core​/event​_handler​/openapi​/​#swagger​-ui","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"ukbJ7SDLgH"}],"urlSource":"https://docs.aws.amazon.com/powertools/python/latest/core/event_handler/openapi/#swagger-ui","key":"K76FdCTSHj"},{"type":"text","value":" をもとに作成","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"VPACv4Ly23"}],"key":"Tzt7BAoRYm"}],"key":"SWIHvVLp1F"}],"key":"gAaq9Z0L0Y"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"aws-lambda-web-adapter","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"d1jrkYMd7h"}],"identifier":"aws-lambda-web-adapter","label":"aws-lambda-web-adapter","html_id":"aws-lambda-web-adapter","implicit":true,"key":"LFmz7eaNDI"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"aws-lambda-web-adapterを挟むことでLambda独自のイベント形式が変換され、標準的なWeb App Frameworkが使えるようになる。","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"mWenK9jQpO"}],"key":"KzXigixfyc"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"link","url":"https://github.com/aws/aws-lambda-web-adapter","position":{"start":{"line":5,"column":1},"end":{"line":5,"co