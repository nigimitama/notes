n":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"WmheF5gFTW"}],"key":"sqV9Jj8R6i"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"link","url":"https://docs.aws.amazon.com/ja_jp/lambda/latest/dg/powertools-for-lambda.html","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"Powertools for AWS Lambda - AWS Lambda","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"ZhOQ3UwKCC"}],"urlSource":"https://docs.aws.amazon.com/ja_jp/lambda/latest/dg/powertools-for-lambda.html","key":"qxoCnHesx6"}],"key":"MPCZnWo1J5"},{"type":"details","children":[{"type":"summary","children":[{"type":"text","value":"コード例","position":{"start":{"line":7,"column":1},"end":{"line":7,"column":1}},"key":"y4fhWjhJfF"}],"key":"HrtaCtd7A7"},{"type":"code","lang":"python","value":"from typing import List\nimport requests\nfrom pydantic import BaseModel, Field\nfrom aws_lambda_powertools import Logger, Tracer\nfrom aws_lambda_powertools.event_handler import APIGatewayRestResolver\nfrom aws_lambda_powertools.utilities.typing import LambdaContext\n\ntracer = Tracer()\nlogger = Logger()\napp = APIGatewayRestResolver(enable_validation=True)\napp.enable_swagger(path=\"/swagger\")  # OpenAPI仕様書 \n\nclass Todo(BaseModel):  # Pydanticによる型定義とバリデーション\n    userId: int\n    id_: int = Field(alias=\"id\")\n    title: str\n    completed: bool\n\n\n@app.post(\"/todos\") # POST /todos へのルーティング\ndef create_todo(todo: Todo) -> str:\n    response = requests.post(\"https://jsonplaceholder.typicode.com/todos\", json=todo.dict(by_alias=True))\n    response.raise_for_status()\n    return response.json()[\"id\"]\n\n\n@app.get(\"/todos\") # GET /todos へのルーティング\ndef get_todos() -> List[Todo]:\n    todo = requests.get(\"https://jsonplaceholder.typicode.com/todos\")\n    todo.raise_for_status()\n    return todo.json()\n\n\ndef lambda_handler(event: dict, context: LambdaContext) -> dict:\n    return app.resolve(event, context)","position":{"start":{"line":9,"column":1},"end":{"line":45,"column":1}},"key":"jSQVSmhw3S"},{"type":"paragraph","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"link","url":"https://docs.aws.amazon.com/powertools/python/latest/core/event_handler/openapi/#swagger-ui","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"children":[{"type":"text","value":"https://​docs​.aws​.amazon​.com​/powertools​/python​/latest​/core​/event​_handler​/openapi​/​#swagger​-ui","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"Wl6W85Kig8"}],"urlSource":"https://docs.aws.amazon.com/powertools/python/latest/core/event_handler/openapi/#swagger-ui","key":"WRjT7Dmn9d"},{"type":"text","value":" をもとに作成","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"MOkjIFcBil"}],"key":"xekLan0Cfv"}],"key":"KjDiUmGl8G"}],"key":"WlQJfo3yXW"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"aws-lambda-web-adapter","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"QPYo8e2g14"}],"identifier":"aws-lambda-web-adapter","label":"aws-lambda-web-adapter","html_id":"aws-lambda-web-adapter","implicit":true,"key":"bp9he3ZisQ"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"aws-lambda-web-adapterを挟むことでLambda独自のイベント形式が変換され、標準的なWeb App Frameworkが使えるようになる。","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"vBjVsMy9nf"}],"key":"FjmD1Tj9GD"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"link","url":"https://github.com/aws/aws-lambda-web-adapter","position":{"start":{"line":5,"column":1},"end":{"line":5,"co