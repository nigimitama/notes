key":"q9ruxoVfCw"},{"type":"text","value":"が、他の言語でも自作のResult型を作れば同様のことはできる。","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"wCUEBEsXgz"}],"key":"awBQuZKCoN"},{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"link","url":"https://zenn.dev/recustomer/articles/fa30d496a7eb1e","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"Pythonの型ヒントと共に進化するコード（#21: Result 型を自作する）","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"UEkeiym71H"}],"urlSource":"https://zenn.dev/recustomer/articles/fa30d496a7eb1e","key":"yUQlXGNNuT"},{"type":"text","value":" が詳細な実装例を残している","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"CuEuoxkqld"}],"key":"X7LYPi3pM1"}],"key":"bsIEIKysqa"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"# --------------------------------------------\n# Result型の定義\n# --------------------------------------------\nfrom dataclasses import dataclass\nfrom typing import final\n\n@final\n@dataclass(frozen=True, slots=True)\nclass Ok[T]:\n    \"\"\"成功を表すコンテナ\n\n    T: 成功時の値の型\n    \"\"\"\n    value: T\n\n@final\n@dataclass(frozen=True, slots=True)\nclass Err[E]:\n    \"\"\"失敗を表すコンテナ\n\n    E: エラーの型\n    \"\"\"\n    error: E\n\ntype Result[T, E] = Ok[T] | Err[E]","visibility":"show","key":"OIjnyS68A4"},{"type":"outputs","id":"G8j90155l_3VIyryf0fqX","children":[],"visibility":"show","key":"GfYIcouhtR"}],"visibility":"show","key":"HfwJ6zl5Le"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"# --------------------------------------------\n# sqrt関数の定義\n# --------------------------------------------\ndef sqrt(x: float) -> Result:\n    if x < 0:\n        return Err(error=ValueError(\"input is a negative number\"))\n\n    return Ok(value=x ** (1/2))\n\n\ndef print_sqrt(x: float) -> None:\n    result: Result = sqrt(x)\n    if isinstance(result, Ok):\n        print(f\"{x} の平方根は {result.value} です\")\n    else:\n        print(f\"平方根の計算に失敗しました：{result.error}\")\n\nprint_sqrt(2)\nprint_sqrt(-1)","visibility":"show","key":"dpMS7PTqqO"},{"type":"outputs","id":"F3q9YjA_SMAhkOxlK9Nln","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"2 の平方根は 1.4142135623730951 です\n平方根の計算に失敗しました：input is a negative number\n"},"children":[],"key":"cUNdEVh1KY"}],"visibility":"show","key":"vh3ukmd3TO"}],"visibility":"show","key":"ZY0FX7MEPi"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"inlineCode","value":"is_ok()","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vIyb2IvB6s"},{"type":"text","value":"、","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"icA2YRbcAs"},{"type":"inlineCode","value":"is_err()","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"MRGTUvvePb"},{"type":"text","value":"のような関数を作る方法もある","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"kSBwoifVco"}],"key":"X61DdwLDFh"}],"key":"QhqHBfjvYB"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"# --------------------------------------------\n# is_ok, is_err\n# --------------------------------------------\nfrom typing_extensions import TypeIs # Python 3.12以前\n# from typing import TypeIs  # 3.13 以降\n\n\ndef is_ok[T, E](result: Result[T, E]) -> TypeIs[Ok[T]]:\n    \"\"\"成功かどうかを判定し、型を絞り込む\"\"\"\n    return isinstance(result, Ok)\n\n\ndef is_err[T, E](result: Result[T, E]) -> TypeIs[Err[E]]:\n    \"\"\"失敗かどうかを判定し、型を絞り込む\"\"\"\n    return isinstance(result, Err)\n\n\n# --------------------------------------------\ndef print_sqrt(x: float) -> None:\n    result: Result = sqrt(x)\n    if is_err(result):\n        print(f\"平方根の計算に失敗しました：{result.error}\")\n        return\n\n    print(f\"{x} の平方根は {result.value} です\")\n\n\nprint_sqrt(2)\nprint_sqrt(-1)","visibility":"show","key":"gzwB6hiBZQ"},{"type":"outputs","id":"8kxtgSMab7RbADJ96Jq73","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"2 の平方根は 1.4142135623730951 です\n平方根の計算に失敗しました：input is a negative number\n"},"children":[],"key":"YOcnAL4jay"}],"visibility":"show","key":"kBWVrEMyLO"}],"visibility":"show","key":"JgdG2LioNQ"}],"key":"p7l4CmlVuZ"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Good Code","url":"/software-engineering/design/good-code","group":"ソフトウェア工学"},"next":{"title":"ソフトウェアアーキテクチャ","url":"/software-engineering/software-architecture","group":"ソフトウェア工学"}}},"domain":"http://localhost:3000"}