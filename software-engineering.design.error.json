key":"XX8Yxm2E6I"},{"type":"text","value":"が、他の言語でも自作のResult型を作れば同様のことはできる。","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Kvmttm3LMw"}],"key":"IFGS2l7Ar2"},{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"link","url":"https://zenn.dev/recustomer/articles/fa30d496a7eb1e","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"Pythonの型ヒントと共に進化するコード（#21: Result 型を自作する）","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"v4kOABz6aL"}],"urlSource":"https://zenn.dev/recustomer/articles/fa30d496a7eb1e","key":"L38O31Lmw0"},{"type":"text","value":" が詳細な実装例を残している","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"dnq3N9KqP8"}],"key":"QyiZnz2c3J"}],"key":"UOHP917Y0g"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"# --------------------------------------------\n# Result型の定義\n# --------------------------------------------\nfrom dataclasses import dataclass\nfrom typing import final\n\n@final\n@dataclass(frozen=True, slots=True)\nclass Ok[T]:\n    \"\"\"成功を表すコンテナ\n\n    T: 成功時の値の型\n    \"\"\"\n    value: T\n\n@final\n@dataclass(frozen=True, slots=True)\nclass Err[E]:\n    \"\"\"失敗を表すコンテナ\n\n    E: エラーの型\n    \"\"\"\n    error: E\n\ntype Result[T, E] = Ok[T] | Err[E]","visibility":"show","key":"u4FqjJu5TU"},{"type":"outputs","id":"_NNfPYhqKimVu9Bum97CK","children":[],"visibility":"show","key":"Svm0X34ld9"}],"visibility":"show","key":"bnBF2tfduP"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"# --------------------------------------------\n# sqrt関数の定義\n# --------------------------------------------\ndef sqrt(x: float) -> Result:\n    if x < 0:\n        return Err(error=ValueError(\"input is a negative number\"))\n\n    return Ok(value=x ** (1/2))\n\n\ndef print_sqrt(x: float) -> None:\n    result: Result = sqrt(x)\n    if isinstance(result, Ok):\n        print(f\"{x} の平方根は {result.value} です\")\n    else:\n        print(f\"平方根の計算に失敗しました：{result.error}\")\n\nprint_sqrt(2)\nprint_sqrt(-1)","visibility":"show","key":"FUYihdoETK"},{"type":"outputs","id":"WMK3PzfXYskZl8INU6D2k","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"2 の平方根は 1.4142135623730951 です\n平方根の計算に失敗しました：input is a negative number\n"},"children":[],"key":"Gs3VJq1JrA"}],"visibility":"show","key":"l7itiEEsAA"}],"visibility":"show","key":"trPwLLXR2V"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"inlineCode","value":"is_ok()","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"m5BUSgolYG"},{"type":"text","value":"、","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"jQtbompgRO"},{"type":"inlineCode","value":"is_err()","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"MFUXljGBmx"},{"type":"text","value":"のような関数を作る方法もある","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"VadSi1tDv3"}],"key":"e56qFG4PPp"}],"key":"gPc5PF1eu4"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"# --------------------------------------------\n# is_ok, is_err\n# --------------------------------------------\nfrom typing_extensions import TypeIs # Python 3.12以前\n# from typing import TypeIs  # 3.13 以降\n\n\ndef is_ok[T, E](result: Result[T, E]) -> TypeIs[Ok[T]]:\n    \"\"\"成功かどうかを判定し、型を絞り込む\"\"\"\n    return isinstance(result, Ok)\n\n\ndef is_err[T, E](result: Result[T, E]) -> TypeIs[Err[E]]:\n    \"\"\"失敗かどうかを判定し、型を絞り込む\"\"\"\n    return isinstance(result, Err)\n\n\n# --------------------------------------------\ndef print_sqrt(x: float) -> None:\n    result: Result = sqrt(x)\n    if is_err(result):\n        print(f\"平方根の計算に失敗しました：{result.error}\")\n        return\n\n    print(f\"{x} の平方根は {result.value} です\")\n\n\nprint_sqrt(2)\nprint_sqrt(-1)","visibility":"show","key":"QRwH9ySynZ"},{"type":"outputs","id":"tbERzXlTZpZNdZRaqBcHC","children":[{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"2 の平方根は 1.4142135623730951 です\n平方根の計算に失敗しました：input is a negative number\n"},"children":[],"key":"kNkOpX4DAL"}],"visibility":"show","key":"ggWWKTZQ7r"}],"visibility":"show","key":"ZSAMi9PmPM"}],"key":"c97Yp0Mq1G"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Good Code","url":"/software-engineering/design/good-code","group":"ソフトウェア工学"},"next":{"title":"ソフトウェアアーキテクチャ","url":"/software-engineering/software-architecture","group":"ソフトウェア工学"}}},"domain":"http://localhost:3000"}