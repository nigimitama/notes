ing(\"cheese\").add_topping(\"olive\").build()","visibility":"show","key":"ppvZyMUnxd"},{"type":"outputs","id":"1ghbCNnM8axcOkczODYep","children":[],"visibility":"show","key":"TPod29oEqA"}],"visibility":"show","key":"E3T5S60207"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Prototype","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"yXr0WsAitG"}],"identifier":"prototype","label":"Prototype","html_id":"prototype","implicit":true,"key":"Ia5BFN1NuY"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"既存のインスタンスを複製（clone）することで新しいオブジェクトを作るパターン。生成コストが高いオブジェクトや、\n初期状態を維持したままバリエーションを作りたい場合に使う。Pythonでは標準ライブラリの ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"XrWntdxdxS"},{"type":"inlineCode","value":"copy.deepcopy","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"XMSnA1JWnY"},{"type":"text","value":" がそのまま使える。","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"a520xnA26a"}],"key":"xmG772XN6w"}],"key":"aHxepp5nan"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"import copy\n\nclass Sheep:\n    def __init__(self, name):\n        self.name = name\n\noriginal = Sheep(\"Dolly\")\nclone = copy.deepcopy(original)\nclone.name = \"Dolly Jr.\"\noriginal.name","visibility":"show","key":"uIvFzSVYiu"},{"type":"outputs","id":"wLLyjCWwQNcHFddZieKNb","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":4,"metadata":{},"data":{"text/plain":{"content":"'Dolly'","content_type":"text/plain"}}},"children":[],"key":"Ny8gK6X1ce"}],"visibility":"show","key":"hbWTpObJw5"}],"visibility":"show","key":"XYo9zG8dQb"}],"key":"lqV3G7XM69"},"references":{"ci