ing(\"cheese\").add_topping(\"olive\").build()","visibility":"show","key":"VskZjL7GXc"},{"type":"outputs","id":"5jUkwW4DTaxzOc2M6mTiu","children":[],"visibility":"show","key":"xqWfOxxK7D"}],"visibility":"show","key":"ncXpUwozhf"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Prototype","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"YJc168UC7x"}],"identifier":"prototype","label":"Prototype","html_id":"prototype","implicit":true,"key":"i5qcQU3OVB"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"既存のインスタンスを複製（clone）することで新しいオブジェクトを作るパターン。生成コストが高いオブジェクトや、\n初期状態を維持したままバリエーションを作りたい場合に使う。Pythonでは標準ライブラリの ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ZgFqknTdc4"},{"type":"inlineCode","value":"copy.deepcopy","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"JYOv111AE0"},{"type":"text","value":" がそのまま使える。","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"RR9rz7OK3U"}],"key":"uR1XqxJC8r"}],"key":"ANrJVXcrOV"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"import copy\n\nclass Sheep:\n    def __init__(self, name):\n        self.name = name\n\noriginal = Sheep(\"Dolly\")\nclone = copy.deepcopy(original)\nclone.name = \"Dolly Jr.\"\noriginal.name","visibility":"show","key":"H6xUPkqScU"},{"type":"outputs","id":"MwsHJ8WIwGZDgha-scb7d","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":4,"metadata":{},"data":{"text/plain":{"content":"'Dolly'","content_type":"text/plain"}}},"children":[],"key":"btAwIhpMhw"}],"visibility":"show","key":"KMBqMR8Y85"}],"visibility":"show","key":"oLW6hzWewq"}],"key":"tzHtqp4NPs"},"references":{"ci