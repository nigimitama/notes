ing(\"cheese\").add_topping(\"olive\").build()","visibility":"show","key":"jBZpnefESS"},{"type":"outputs","id":"xow97AnJk1Kvnfg8GmJAn","children":[],"visibility":"show","key":"Br0XFIc0cL"}],"visibility":"show","key":"fTxLQwra3F"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Prototype","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"XipgNJItyB"}],"identifier":"prototype","label":"Prototype","html_id":"prototype","implicit":true,"key":"ceuPhW9TX4"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"既存のインスタンスを複製（clone）することで新しいオブジェクトを作るパターン。生成コストが高いオブジェクトや、\n初期状態を維持したままバリエーションを作りたい場合に使う。Pythonでは標準ライブラリの ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"zbSJZdWhW1"},{"type":"inlineCode","value":"copy.deepcopy","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"xHKavSxFv9"},{"type":"text","value":" がそのまま使える。","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"xe6wv1O1mp"}],"key":"xgy1729FeG"}],"key":"ZusaseX1di"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"import copy\n\nclass Sheep:\n    def __init__(self, name):\n        self.name = name\n\noriginal = Sheep(\"Dolly\")\nclone = copy.deepcopy(original)\nclone.name = \"Dolly Jr.\"\noriginal.name","visibility":"show","key":"riWlZgbKXk"},{"type":"outputs","id":"rRNL_n9DOLDiJFYGhPrZ-","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":4,"metadata":{},"data":{"text/plain":{"content":"'Dolly'","content_type":"text/plain"}}},"children":[],"key":"DrtiK82Udq"}],"visibility":"show","key":"hqkOqG2f0v"}],"visibility":"show","key":"OYCYnFLGni"}],"key":"nWM9DRnjKO"},"references":{"ci