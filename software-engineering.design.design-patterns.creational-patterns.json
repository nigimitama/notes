ing(\"cheese\").add_topping(\"olive\").build()","visibility":"show","key":"NPgZs35a2d"},{"type":"outputs","id":"O5KfdRr2mHavoyPnv-CEu","children":[],"visibility":"show","key":"BrlA6grw7x"}],"visibility":"show","key":"jy1ydoQnrG"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Prototype","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"C4vKhq0epv"}],"identifier":"prototype","label":"Prototype","html_id":"prototype","implicit":true,"key":"ToqWRF9cPU"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"既存のインスタンスを複製（clone）することで新しいオブジェクトを作るパターン。生成コストが高いオブジェクトや、\n初期状態を維持したままバリエーションを作りたい場合に使う。Pythonでは標準ライブラリの ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Ik80WTZghM"},{"type":"inlineCode","value":"copy.deepcopy","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"bUCoy5ivBq"},{"type":"text","value":" がそのまま使える。","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"GLpnSW46pr"}],"key":"nzJi3eFUQ1"}],"key":"x1Ojw3a5rp"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"import copy\n\nclass Sheep:\n    def __init__(self, name):\n        self.name = name\n\noriginal = Sheep(\"Dolly\")\nclone = copy.deepcopy(original)\nclone.name = \"Dolly Jr.\"\noriginal.name","visibility":"show","key":"YJF9mzsgBQ"},{"type":"outputs","id":"pqXtRHrSWTpxTmlTnJHHn","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":4,"metadata":{},"data":{"text/plain":{"content":"'Dolly'","content_type":"text/plain"}}},"children":[],"key":"t8ilyZ6UHC"}],"visibility":"show","key":"tNZEY9WN7x"}],"visibility":"show","key":"upweXsWux8"}],"key":"INBO5HJADn"},"references":{"ci