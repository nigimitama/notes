ing(\"cheese\").add_topping(\"olive\").build()","visibility":"show","key":"g7vgEqVGRf"},{"type":"outputs","id":"WWTSLflXyWQ6OEARPJxFN","children":[],"visibility":"show","key":"p37hMSeSul"}],"visibility":"show","key":"bVDlkG01pv"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Prototype","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"iOu38qM1tc"}],"identifier":"prototype","label":"Prototype","html_id":"prototype","implicit":true,"key":"wv4W9AeWRg"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"既存のインスタンスを複製（clone）することで新しいオブジェクトを作るパターン。生成コストが高いオブジェクトや、\n初期状態を維持したままバリエーションを作りたい場合に使う。Pythonでは標準ライブラリの ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"c1SWf2fAW9"},{"type":"inlineCode","value":"copy.deepcopy","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"HwGx1wsAoI"},{"type":"text","value":" がそのまま使える。","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"bnFRs6Fu5W"}],"key":"L8ONuHnEmu"}],"key":"PETr8M0vSN"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"import copy\n\nclass Sheep:\n    def __init__(self, name):\n        self.name = name\n\noriginal = Sheep(\"Dolly\")\nclone = copy.deepcopy(original)\nclone.name = \"Dolly Jr.\"\noriginal.name","visibility":"show","key":"UXN7SYopLO"},{"type":"outputs","id":"TTcNZig3THQ63KIMAxng1","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":4,"metadata":{},"data":{"text/plain":{"content":"'Dolly'","content_type":"text/plain"}}},"children":[],"key":"I3M3cGuXUy"}],"visibility":"show","key":"qT8ZqQq2HY"}],"visibility":"show","key":"WrXhAfTWhZ"}],"key":"vwV1xSVEXd"},"references":{"ci