ing(\"cheese\").add_topping(\"olive\").build()","visibility":"show","key":"J5vvnubxCw"},{"type":"outputs","id":"iw4OzwH_LXolrMKFLY7uz","children":[],"visibility":"show","key":"P0VP0YAMnh"}],"visibility":"show","key":"zSvlRYofBR"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Prototype","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"WUrDLNmiwg"}],"identifier":"prototype","label":"Prototype","html_id":"prototype","implicit":true,"key":"i0bICHLW2b"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"既存のインスタンスを複製（clone）することで新しいオブジェクトを作るパターン。生成コストが高いオブジェクトや、\n初期状態を維持したままバリエーションを作りたい場合に使う。Pythonでは標準ライブラリの ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"afSpSUmYPi"},{"type":"inlineCode","value":"copy.deepcopy","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ZGB3PAqMCT"},{"type":"text","value":" がそのまま使える。","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"v9PuGELnhN"}],"key":"kmKG4vob8w"}],"key":"ZG7A03avuo"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"import copy\n\nclass Sheep:\n    def __init__(self, name):\n        self.name = name\n\noriginal = Sheep(\"Dolly\")\nclone = copy.deepcopy(original)\nclone.name = \"Dolly Jr.\"\noriginal.name","visibility":"show","key":"U4zwe1HW7r"},{"type":"outputs","id":"dsUrFzEPztupyCU9jwNaQ","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":4,"metadata":{},"data":{"text/plain":{"content":"'Dolly'","content_type":"text/plain"}}},"children":[],"key":"NkCagtNFKI"}],"visibility":"show","key":"nBNm6mvxFr"}],"visibility":"show","key":"EXiBVBoRZ4"}],"key":"I8yS2miJlR"},"references":{"ci