ing(\"cheese\").add_topping(\"olive\").build()","visibility":"show","key":"oYRqvJlkM3"},{"type":"outputs","id":"a9cKxDPzgB3Ai4a4y51F0","children":[],"visibility":"show","key":"Ll21TCGgdC"}],"visibility":"show","key":"pjt6nQhQvj"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Prototype","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Pbo8AFedZp"}],"identifier":"prototype","label":"Prototype","html_id":"prototype","implicit":true,"key":"MNcls1cvqW"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"既存のインスタンスを複製（clone）することで新しいオブジェクトを作るパターン。生成コストが高いオブジェクトや、\n初期状態を維持したままバリエーションを作りたい場合に使う。Pythonでは標準ライブラリの ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"J3KgZB90gK"},{"type":"inlineCode","value":"copy.deepcopy","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"XU7G6HnOaA"},{"type":"text","value":" がそのまま使える。","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"GLdwuL9Szt"}],"key":"ZhvxwO3vSX"}],"key":"qNwFTN5EnI"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"import copy\n\nclass Sheep:\n    def __init__(self, name):\n        self.name = name\n\noriginal = Sheep(\"Dolly\")\nclone = copy.deepcopy(original)\nclone.name = \"Dolly Jr.\"\noriginal.name","visibility":"show","key":"JwSyjgIoak"},{"type":"outputs","id":"eBogSau34YZWWZzmUb-I-","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":4,"metadata":{},"data":{"text/plain":{"content":"'Dolly'","content_type":"text/plain"}}},"children":[],"key":"bydIGuEETb"}],"visibility":"show","key":"EZ0IHSSlHi"}],"visibility":"show","key":"qEbsM81A4h"}],"key":"prOLGgyL7j"},"references":{"ci