ing(\"cheese\").add_topping(\"olive\").build()","visibility":"show","key":"lmGOt4W1hg"},{"type":"outputs","id":"3uxnHstP7hYwc2GhNR3Iq","children":[],"visibility":"show","key":"sPsiSoJkwN"}],"visibility":"show","key":"hYaMbJuyNZ"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Prototype","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"lAqxgbRXpg"}],"identifier":"prototype","label":"Prototype","html_id":"prototype","implicit":true,"key":"piRxGLv9rn"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"既存のインスタンスを複製（clone）することで新しいオブジェクトを作るパターン。生成コストが高いオブジェクトや、\n初期状態を維持したままバリエーションを作りたい場合に使う。Pythonでは標準ライブラリの ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"zicxxbb9N6"},{"type":"inlineCode","value":"copy.deepcopy","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"vjWDgmGKsZ"},{"type":"text","value":" がそのまま使える。","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ccsbIj7fs4"}],"key":"NicpQmmVWJ"}],"key":"YdjE9V4IpG"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"import copy\n\nclass Sheep:\n    def __init__(self, name):\n        self.name = name\n\noriginal = Sheep(\"Dolly\")\nclone = copy.deepcopy(original)\nclone.name = \"Dolly Jr.\"\noriginal.name","visibility":"show","key":"Xy2TVgRYDg"},{"type":"outputs","id":"tcJ7m8wkkvTSwxKxJi_ld","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":4,"metadata":{},"data":{"text/plain":{"content":"'Dolly'","content_type":"text/plain"}}},"children":[],"key":"TjtU7c6MG2"}],"visibility":"show","key":"PHljmwuhpd"}],"visibility":"show","key":"Wyit7GKCvq"}],"key":"fhFa7RHYq4"},"references":{"ci