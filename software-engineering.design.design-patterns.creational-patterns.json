ing(\"cheese\").add_topping(\"olive\").build()","visibility":"show","key":"V6Aj5wkzTG"},{"type":"outputs","id":"OczSW020U-fjSABz73dor","children":[],"visibility":"show","key":"TQAFzvefVm"}],"visibility":"show","key":"ajL0GcdlEW"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Prototype","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"udLnjCnBfb"}],"identifier":"prototype","label":"Prototype","html_id":"prototype","implicit":true,"key":"IUZMpIIiLj"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"既存のインスタンスを複製（clone）することで新しいオブジェクトを作るパターン。生成コストが高いオブジェクトや、\n初期状態を維持したままバリエーションを作りたい場合に使う。Pythonでは標準ライブラリの ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"WcjOc7A1hh"},{"type":"inlineCode","value":"copy.deepcopy","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"P1Wgh0SPHS"},{"type":"text","value":" がそのまま使える。","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"plI04H7wU6"}],"key":"Hvbz1Rhg0V"}],"key":"oRKNRqN2SS"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"import copy\n\nclass Sheep:\n    def __init__(self, name):\n        self.name = name\n\noriginal = Sheep(\"Dolly\")\nclone = copy.deepcopy(original)\nclone.name = \"Dolly Jr.\"\noriginal.name","visibility":"show","key":"pZ0H5kziyh"},{"type":"outputs","id":"dfVRD6sfRsywj3Q_dnBWm","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":4,"metadata":{},"data":{"text/plain":{"content":"'Dolly'","content_type":"text/plain"}}},"children":[],"key":"Glmq03ezxq"}],"visibility":"show","key":"PLfMWPL5c5"}],"visibility":"show","key":"BlYpSsuAx6"}],"key":"AYW6Ktp9It"},"references":{"ci