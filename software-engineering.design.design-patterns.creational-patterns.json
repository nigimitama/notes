ing(\"cheese\").add_topping(\"olive\").build()","visibility":"show","key":"a6LwJoVI3s"},{"type":"outputs","id":"YLN9JccXX83BhpTBxeTJZ","children":[],"visibility":"show","key":"hL1EHx4vLO"}],"visibility":"show","key":"hhn6Uxcd2F"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Prototype","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"SZ3ybsr8jh"}],"identifier":"prototype","label":"Prototype","html_id":"prototype","implicit":true,"key":"mdGuwXUY0s"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"既存のインスタンスを複製（clone）することで新しいオブジェクトを作るパターン。生成コストが高いオブジェクトや、\n初期状態を維持したままバリエーションを作りたい場合に使う。Pythonでは標準ライブラリの ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"DJJz2KW6UN"},{"type":"inlineCode","value":"copy.deepcopy","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"VVQZuzfv07"},{"type":"text","value":" がそのまま使える。","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"JryCxgnnT2"}],"key":"S8VMy3w0Cg"}],"key":"LqttEmPKrB"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"import copy\n\nclass Sheep:\n    def __init__(self, name):\n        self.name = name\n\noriginal = Sheep(\"Dolly\")\nclone = copy.deepcopy(original)\nclone.name = \"Dolly Jr.\"\noriginal.name","visibility":"show","key":"dHG4XFScoZ"},{"type":"outputs","id":"Pdhb0S5VxLebb3pGZwQSo","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":4,"metadata":{},"data":{"text/plain":{"content":"'Dolly'","content_type":"text/plain"}}},"children":[],"key":"i22uqgwlEv"}],"visibility":"show","key":"vQiFWlH9wy"}],"visibility":"show","key":"fBw7LTbCFJ"}],"key":"YH16XOvxf8"},"references":{"ci