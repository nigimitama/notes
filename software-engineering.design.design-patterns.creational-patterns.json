ing(\"cheese\").add_topping(\"olive\").build()","visibility":"show","key":"Z2JaaH5fpQ"},{"type":"outputs","id":"YhYNXXBiwMuf0dhpTMdLw","children":[],"visibility":"show","key":"Icrxzdlj23"}],"visibility":"show","key":"y4HoB9Bz13"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Prototype","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"luIzLMeOj9"}],"identifier":"prototype","label":"Prototype","html_id":"prototype","implicit":true,"key":"tjwHFMmQnn"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"既存のインスタンスを複製（clone）することで新しいオブジェクトを作るパターン。生成コストが高いオブジェクトや、\n初期状態を維持したままバリエーションを作りたい場合に使う。Pythonでは標準ライブラリの ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"yThfnHs6PK"},{"type":"inlineCode","value":"copy.deepcopy","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"QYHzuUxPlU"},{"type":"text","value":" がそのまま使える。","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ec28XBfGEx"}],"key":"FYUSln6V4G"}],"key":"KzzVQc1EoI"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"import copy\n\nclass Sheep:\n    def __init__(self, name):\n        self.name = name\n\noriginal = Sheep(\"Dolly\")\nclone = copy.deepcopy(original)\nclone.name = \"Dolly Jr.\"\noriginal.name","visibility":"show","key":"Ay8x7vhGkR"},{"type":"outputs","id":"x1F_ODmGqZX9Dd3ChTBxd","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":4,"metadata":{},"data":{"text/plain":{"content":"'Dolly'","content_type":"text/plain"}}},"children":[],"key":"oElDIIMhWv"}],"visibility":"show","key":"N2mlvBjQnx"}],"visibility":"show","key":"zWGnF1l6jA"}],"key":"GbSdBYpbn1"},"references":{"ci