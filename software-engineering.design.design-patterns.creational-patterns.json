ing(\"cheese\").add_topping(\"olive\").build()","visibility":"show","key":"Usw4Ba4YxA"},{"type":"outputs","id":"XoyXLU0agWdYJf5eq_PYh","children":[],"visibility":"show","key":"LCfzYEVJrN"}],"visibility":"show","key":"Yc59DiraCD"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Prototype","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"bqEeIpQFF7"}],"identifier":"prototype","label":"Prototype","html_id":"prototype","implicit":true,"key":"otSz4NM0rx"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"既存のインスタンスを複製（clone）することで新しいオブジェクトを作るパターン。生成コストが高いオブジェクトや、\n初期状態を維持したままバリエーションを作りたい場合に使う。Pythonでは標準ライブラリの ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"AnrySKa9Y6"},{"type":"inlineCode","value":"copy.deepcopy","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"lmz0GgREhC"},{"type":"text","value":" がそのまま使える。","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Vd6Vnh5t4I"}],"key":"E8rLLvFCjs"}],"key":"Ab4OWfx1cs"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"import copy\n\nclass Sheep:\n    def __init__(self, name):\n        self.name = name\n\noriginal = Sheep(\"Dolly\")\nclone = copy.deepcopy(original)\nclone.name = \"Dolly Jr.\"\noriginal.name","visibility":"show","key":"PdVZCj5uDA"},{"type":"outputs","id":"GHXcppJy7hODyhvRa101p","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":4,"metadata":{},"data":{"text/plain":{"content":"'Dolly'","content_type":"text/plain"}}},"children":[],"key":"ZQRyorTgZH"}],"visibility":"show","key":"FrvTA4QQ46"}],"visibility":"show","key":"TPCvgNHwny"}],"key":"LaMfOi2XdU"},"references":{"ci