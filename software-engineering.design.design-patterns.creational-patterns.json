ing(\"cheese\").add_topping(\"olive\").build()","visibility":"show","key":"d8mBkXd81i"},{"type":"outputs","id":"zB3R50pBwReREy8m5fCcS","children":[],"visibility":"show","key":"qIeKPwnovv"}],"visibility":"show","key":"zsvuEnxMPT"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Prototype","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"hBlDDs5QQ0"}],"identifier":"prototype","label":"Prototype","html_id":"prototype","implicit":true,"key":"urkHbBIRtT"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"既存のインスタンスを複製（clone）することで新しいオブジェクトを作るパターン。生成コストが高いオブジェクトや、\n初期状態を維持したままバリエーションを作りたい場合に使う。Pythonでは標準ライブラリの ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"wK0AUU3hye"},{"type":"inlineCode","value":"copy.deepcopy","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ouPfJn3d0H"},{"type":"text","value":" がそのまま使える。","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"jEaIF3LGB5"}],"key":"rmu77YsuC4"}],"key":"yZZqyPtfd8"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"import copy\n\nclass Sheep:\n    def __init__(self, name):\n        self.name = name\n\noriginal = Sheep(\"Dolly\")\nclone = copy.deepcopy(original)\nclone.name = \"Dolly Jr.\"\noriginal.name","visibility":"show","key":"dT2nVtYm1c"},{"type":"outputs","id":"cZ5oOX7Y3_pWZS7WtLWRl","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":4,"metadata":{},"data":{"text/plain":{"content":"'Dolly'","content_type":"text/plain"}}},"children":[],"key":"lig5oXAdZX"}],"visibility":"show","key":"Nj4vzDeBZ6"}],"visibility":"show","key":"SEilk5Ta86"}],"key":"Rt7hqf4RST"},"references":{"ci