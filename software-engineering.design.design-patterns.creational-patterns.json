ing(\"cheese\").add_topping(\"olive\").build()","visibility":"show","key":"TYofpDH5Qt"},{"type":"outputs","id":"yr815Test-EP8S7gs6TSU","children":[],"visibility":"show","key":"M1Ms7bKhWH"}],"visibility":"show","key":"l0o8jZq752"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Prototype","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"HvPK7b1FLC"}],"identifier":"prototype","label":"Prototype","html_id":"prototype","implicit":true,"key":"SWjd7Z96Nm"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"既存のインスタンスを複製（clone）することで新しいオブジェクトを作るパターン。生成コストが高いオブジェクトや、\n初期状態を維持したままバリエーションを作りたい場合に使う。Pythonでは標準ライブラリの ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"C2QiqPvBiP"},{"type":"inlineCode","value":"copy.deepcopy","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"b0GP23oNja"},{"type":"text","value":" がそのまま使える。","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Da9HddTxTI"}],"key":"bEdV9jrg2m"}],"key":"fEVtf7ORLp"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"import copy\n\nclass Sheep:\n    def __init__(self, name):\n        self.name = name\n\noriginal = Sheep(\"Dolly\")\nclone = copy.deepcopy(original)\nclone.name = \"Dolly Jr.\"\noriginal.name","visibility":"show","key":"EHZgAprb6k"},{"type":"outputs","id":"npZYo99Ua2p_XSX19YePu","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":4,"metadata":{},"data":{"text/plain":{"content":"'Dolly'","content_type":"text/plain"}}},"children":[],"key":"wkZLQFnZNB"}],"visibility":"show","key":"J6ce6fzYGZ"}],"visibility":"show","key":"SNsXg5ybhR"}],"key":"Sf510gpH6A"},"references":{"ci