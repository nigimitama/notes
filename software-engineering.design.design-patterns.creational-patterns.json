ing(\"cheese\").add_topping(\"olive\").build()","visibility":"show","key":"bHbuoecHqF"},{"type":"outputs","id":"CER_E8cK5iwwR7jtw5x9-","children":[],"visibility":"show","key":"ngsdyFQ5pa"}],"visibility":"show","key":"xPr4GRIA8R"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Prototype","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ZX0u4zSYMP"}],"identifier":"prototype","label":"Prototype","html_id":"prototype","implicit":true,"key":"Tnha2R6L8t"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"既存のインスタンスを複製（clone）することで新しいオブジェクトを作るパターン。生成コストが高いオブジェクトや、\n初期状態を維持したままバリエーションを作りたい場合に使う。Pythonでは標準ライブラリの ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"PBgM8YOOZT"},{"type":"inlineCode","value":"copy.deepcopy","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"pX35rKNpYN"},{"type":"text","value":" がそのまま使える。","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"IEMGySR5vu"}],"key":"gBdcNGxGyK"}],"key":"bZiKpVDPQM"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"import copy\n\nclass Sheep:\n    def __init__(self, name):\n        self.name = name\n\noriginal = Sheep(\"Dolly\")\nclone = copy.deepcopy(original)\nclone.name = \"Dolly Jr.\"\noriginal.name","visibility":"show","key":"KfwwMiHAgF"},{"type":"outputs","id":"YJknnFWvnCl-y77LvhHrT","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":4,"metadata":{},"data":{"text/plain":{"content":"'Dolly'","content_type":"text/plain"}}},"children":[],"key":"ffqmobu19h"}],"visibility":"show","key":"AuwAh3qLlM"}],"visibility":"show","key":"F6yviIY0PE"}],"key":"fNljUuOjv1"},"references":{"ci