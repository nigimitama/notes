問い合わせとコマンドを分離\ndef peek_next_item(queue):\n    return queue[0]\n\ndef remove_next_item(queue):\n    queue.pop(0)","position":{"start":{"line":8,"column":1},"end":{"line":20,"column":1}},"key":"pK0ZdWfPWu"},{"type":"paragraph","position":{"start":{"line":22,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"CQSを ","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"sVZgphntLC"},{"type":"strong","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"システム全体","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"GerTnl0dOH"}],"key":"Pej84ipu81"},{"type":"text","value":" の書き込み・読み取りモデルの分離にまで拡張した設計が ","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"N4OLbwEAOw"},{"type":"link","url":"/software-engineering/software-architecture/distributed/cqrs","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"CQRS","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"AdiGBR5X4P"}],"urlSource":"../../software_architecture/distributed/cqrs.ipynb","dataUrl":"/software-engineering.software-architecture.distributed.cqrs.json","internal":true,"protocol":"file","key":"brgnJoyBH9"},{"type":"text","value":"。\nCQSが1メソッド単位のミクロな規律であるのに対し、CQRSはモデル・データストアのレベルにまで分離を広げたマクロな適用といえる。","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"fD5pZk8t9T"}],"key":"pVkee0igB4"}],"key":"LtSLRxHZJm"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"最小驚きの原則（Principle of Least Astonishment）","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"IFcnyqgKtB"}],"identifier":"id-principle-of-least-astonishment","label":"最小驚きの原則（Principle of Least Astonishment）","html_id":"id-principle-of-least-astonishment","implicit":true,"key":"SQjkh9tHd6"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"text","value":"インターフェースや関数の振る舞いは、利用者の直感的な予想と一致しているべき、という原則。名前から推測される動作と\n実際の動作にギャップがあると、バグの温床になったり誤用を招いたりする。","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"COdWbyO2rz"}],"key":"etorb9LIH0"},{"type":"code","lang":"python","value":"# 驚きがある例：get_ という名前なのに副作用（保存）を持つ\ndef get_user(user_id):\n    user = db.find(user_id)\n    log_access(user_id)  # ログを書き込むだけならまだしも…\n    user.last_accessed = now()\n    db.save(user)  # 「取得」のはずが実は書き込みも行っている\n    return user","position":{"start":{"line":6,"column":1},"end":{"line":14,"column":1}},"key":"vGVpsXK3tC"},{"type":"paragraph","position":{"start":{"line":16,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"「読み取り専用に見える関数名なのに書き込みをする」は上述のCQS違反の典型例でもあり、最小驚きの原則とCQSは\n同じ問題を別の角度から捉えたものといえる。","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"l33Go2gW2d"}],"key":"nBdykql5bo"}],"key":"iBLr7wNszO"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"契約による設計・防御的プログラミング","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"AX5RW8b5rk"}],"identifier":"id","label":"契約による設計・防御的プログラミング","html_id":"id","implicit":true,"key":"TUrBCQuc7x"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":4,"column":1}},"children":[{"type":"strong","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"契約による設計（Design by Contract, DbC）","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"DUk4ETnb98"}],"key":"kr2iPN7OeM"},{"type":"text","value":"：関数やメソッドが満たすべき「事前条件（呼び出す側の責任）」\n「事後条件（実装する側の責任）」「不変条件」を契約として明示する考え方。Bertrand Meyer が Eiffel 言語で提唱した。","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"BA7IjU8WoE"}],"key":"C4pRVWzF8P"},{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":7,"column":1}},"children":[{"type":"strong","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"防御的プログラミング（Defensive Programming）","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"b06lmtqqbi"}],"key":"H8IO8F6zuy"},{"type":"text","value":"：呼び出し側が契約を破る可能性を前提に、関数の内部で入力を\n検証し続ける考え方。","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"mm6v9tsVqN"}],"key":"omabOK0XQI"},{"type":"paragraph","position":{"start":{"line":9,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"両者はしばしば対立する考え方として語られる。DbCは「契約を守るのは呼び出し側の責任。契約違反はバグなので早期に\n例外で落とす」という立場を取り、際限のない防御的チェックによるコードの肥大化を避けようとする。","position":{"start":{"line":9,"column":1},"end":{"line":9,"column":1}},"key":"Yyy8diVRnd"}],"key":"kQToyl45q6"},{"type":"code","lang":"python","value":"def withdraw(self, amount):\n    assert amount > 0, \"事前条件違反: amount は正の数でなければならない\"  # 契約の明示\n    assert amount <= self.balance, \"事前条件違反: 残高不足\"\n    self.balance -= amount\n    assert self.balance >= 0  # 事後条件・不変条件の確認","position":{"start":{"line":12,"column":1},"end":{"line":18,"column":1}},"key":"vdiDJsPbOR"},{"type":"paragraph","position":{"start":{"line":20,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"一方で、","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"asak9eiigi"},{"type":"strong","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"text","value":"外部からの入力","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"FtOlaYOk7h"}],"key":"lN2veTgT7K"},{"type":"text","value":"（ユーザー入力、外部APIのレスポンスなど、契約を強制できない境界）に対しては防御的な\n検証が必要になる。「信頼できる内部コード間ではDbC的に契約を明示し、信頼できない外部境界では防御的に検証する」という\n使い分けが実践的。","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"F4TXLl6gUw"}],"key":"ztG5a9lNng"}],"key":"iRCdHQxAyG"}],"key":"IYBPFJGjPn"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"基本原則（KISS・YAGNI・DRYほか）","url":"/software-engineering/design/principles/basic-principles","group":"ソフトウェア工学"},"next":{"title":"デザインパターン","url":"/software-engineering/design/design-patterns","group":"ソフトウェア工学"}}},"domain":"http://localhost:3000"}