Jrjd0"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"strong","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"畳み込み（convolution）層","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"jUoQzv8tP5"}],"key":"hnUKB0xKjD"},{"type":"text","value":" は形状を維持する","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"gj3By8k6w4"}],"key":"jpZ04L9IFU"}],"key":"K8npU0hCXj"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"計算","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"RiKNzOXB2V"}],"identifier":"id","label":"計算","html_id":"id-1","implicit":true,"key":"qc4H345cgs"}],"key":"WRKEZG6Y5D"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"畳み込み層","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"UtYRjMnB9P"}],"identifier":"id","label":"畳み込み層","html_id":"id-2","implicit":true,"key":"QoLYhtOLku"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"チャネルごとに、","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"iwwJuCXuW3"},{"type":"strong","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"カーネル（フィルター）","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"dPGDPvSC06"}],"key":"DK8akHDrQl"},{"type":"text","value":" と呼ばれる行列を画像の行列と要素ごとに積をとり、総和をとる","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"yilPhM4fsp"}],"key":"ybaiCmuLvy"}],"key":"pb0cZtpbBv"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\n\nimg = np.array([\n    [1, 2, 3, 0],\n    [0, 1, 2, 3],\n    [3, 0, 1, 2],\n    [2, 3, 0, 1],\n])\n\nker = np.array([\n    [2, 0, 1],\n    [0, 1, 2],\n    [1, 0, 2],\n])\n\nH, W = img.shape\nK = ker.shape[0]\n\nconv = np.zeros((H - K + 1, W - K + 1))\nfor i in range(H - K + 1):\n    for j in range(W - K + 1):\n        conv[i, j] = (img[i:i+K, j:j+K] * ker).sum()\nconv","key":"mSgDyHJltq"},{"type":"outputs","id":"0Z6qPGLgLtiZhjtyLz9Mc","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":33,"metadata":{},"data":{"text/plain":{"content":"array([[15., 16.],\n       [ 6., 15.]])","content_type":"text/plain"}}},"children":[],"key":"MrYvGGxD2T"}],"key":"O2u381Xofl"}],"key":"xZkDOclNN8"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"パディング","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"RXmyVMLkIT"}],"identifier":"id","label":"パディング","html_id":"id-3","implicit":true,"key":"gSxDKyQpbl"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"畳み込みを行う際に、入力データの周囲に固定のデータ（例えば0など）を埋めることがある。これを ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ysfdIp92dX"},{"type":"strong","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"パディング（padding）","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"IV8HlQLPTK"}],"key":"sRPpaURQLV"},{"type":"text","value":" という。","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"JEV11Sb8Dt"}],"key":"B7YWJtbFKT"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"パディングにより畳み込み後の行列のサイズを調整できる","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"fMaIoBI2nm"}],"key":"rqBvxg8Hvw"}],"key":"Hrhu6wOIp8"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\n\n# padding\nimg = np.array([\n    [1, 2, 3, 0],\n    [0, 1, 2, 3],\n    [3, 0, 1, 2],\n    [2, 3, 0, 1],\n])\n\nH, W = img.shape\nimg_pad = np.zeros((H+2, W+2))\nimg_pad[1:-1, 1:-1] = img\nimg_pad","key":"jsPUFTVTly"},{"type":"outputs","id":"pvFZiAZtCqrSVhgcAQF2r","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":41,"metadata":{},"data":{"text/plain":{"content":"array([[0., 0., 0., 0., 0., 0.],\n       [0., 1., 2., 3., 0., 0.],\n       [0., 0., 1., 2., 3., 0.],\n       [0., 3., 0., 1., 2., 0.],\n       [0., 2., 3., 0., 1., 0.],\n       [0., 0., 0., 0., 0., 0.]])","content_type":"text/plain"}}},"children":[],"key":"pMd8yExSVK"}],"key":"kMy28v9fVu"}],"key":"d5ntGbpkTE"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# 畳み込み後も 4 x 4 を維持\nimg = img_pad\nH, W = img.shape\nconv = np.zeros((H - K + 1, W - K + 1))\nfor i in range(H - K + 1):\n    for j in range(W - K + 1):\n        conv[i, j] = (img[i:i+K, j:j+K] * ker).sum()\nconv","key":"gTyMfOG858"},{"type":"outputs","id":"wnv5jl--MdiSDciAMVzvW","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":45,"metadata":{},"data":{"text/plain":{"content":"array([[ 7., 12., 10.,  2.],\n       [ 4., 15., 16., 10.],\n       [10.,  6., 15.,  6.],\n       [ 8., 10.,  4.,  3.]])","content_type":"text/plain"}}},"children":[],"key":"ttqG4huw5S"}],"key":"ypcXhUgSDu"}],"key":"lnSCVFmfnL"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"プーリング層","position":{"start":{"line":1,"column"