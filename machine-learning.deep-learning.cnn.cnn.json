Agxvz"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"strong","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"畳み込み（convolution）層","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"H0iBBARFFh"}],"key":"mLFfihiNXx"},{"type":"text","value":" は形状を維持する","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"mWVBc4IzqX"}],"key":"IrmcpGVwZJ"}],"key":"ozuLPSWTfR"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"計算","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"itQUs79cOP"}],"identifier":"id","label":"計算","html_id":"id-1","implicit":true,"key":"vw8eAa8jc0"}],"key":"jqDTIta2S5"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"畳み込み層","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Pnr01Lz6go"}],"identifier":"id","label":"畳み込み層","html_id":"id-2","implicit":true,"key":"hiQVRpx88N"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"チャネルごとに、","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"QHX4GONCjJ"},{"type":"strong","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"カーネル（フィルター）","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ohjhQFG1kT"}],"key":"RvN34gris8"},{"type":"text","value":" と呼ばれる行列を画像の行列と要素ごとに積をとり、総和をとる","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"k6GpOZxlvo"}],"key":"PUkvIvw9NR"}],"key":"EwzEZzDtmj"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\n\nimg = np.array([\n    [1, 2, 3, 0],\n    [0, 1, 2, 3],\n    [3, 0, 1, 2],\n    [2, 3, 0, 1],\n])\n\nker = np.array([\n    [2, 0, 1],\n    [0, 1, 2],\n    [1, 0, 2],\n])\n\nH, W = img.shape\nK = ker.shape[0]\n\nconv = np.zeros((H - K + 1, W - K + 1))\nfor i in range(H - K + 1):\n    for j in range(W - K + 1):\n        conv[i, j] = (img[i:i+K, j:j+K] * ker).sum()\nconv","key":"D52jXCcgNC"},{"type":"outputs","id":"u-uvl4J5KpRm67UbDYzAl","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":33,"metadata":{},"data":{"text/plain":{"content":"array([[15., 16.],\n       [ 6., 15.]])","content_type":"text/plain"}}},"children":[],"key":"e9kAriCIIx"}],"key":"JqTmjVaUw7"}],"key":"cu7dS1Y3rB"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"パディング","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vsepi1Y2Ec"}],"identifier":"id","label":"パディング","html_id":"id-3","implicit":true,"key":"k9pzaOIg6e"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"畳み込みを行う際に、入力データの周囲に固定のデータ（例えば0など）を埋めることがある。これを ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"wpokpk0A92"},{"type":"strong","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"パディング（padding）","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"a0WXLCsllH"}],"key":"b0VYsLWZZi"},{"type":"text","value":" という。","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"s1bmXA1ChV"}],"key":"uCX3OKsqeZ"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"パディングにより畳み込み後の行列のサイズを調整できる","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"TeoWQrnCLJ"}],"key":"MDjFbVgXLW"}],"key":"uJMQWVYrAZ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\n\n# padding\nimg = np.array([\n    [1, 2, 3, 0],\n    [0, 1, 2, 3],\n    [3, 0, 1, 2],\n    [2, 3, 0, 1],\n])\n\nH, W = img.shape\nimg_pad = np.zeros((H+2, W+2))\nimg_pad[1:-1, 1:-1] = img\nimg_pad","key":"MrKdk1zxs7"},{"type":"outputs","id":"qBNYQzpKts26bDeCRFLAF","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":41,"metadata":{},"data":{"text/plain":{"content":"array([[0., 0., 0., 0., 0., 0.],\n       [0., 1., 2., 3., 0., 0.],\n       [0., 0., 1., 2., 3., 0.],\n       [0., 3., 0., 1., 2., 0.],\n       [0., 2., 3., 0., 1., 0.],\n       [0., 0., 0., 0., 0., 0.]])","content_type":"text/plain"}}},"children":[],"key":"RgRu7gTZfR"}],"key":"iMmCwg6Gdf"}],"key":"kF0p2w1blT"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# 畳み込み後も 4 x 4 を維持\nimg = img_pad\nH, W = img.shape\nconv = np.zeros((H - K + 1, W - K + 1))\nfor i in range(H - K + 1):\n    for j in range(W - K + 1):\n        conv[i, j] = (img[i:i+K, j:j+K] * ker).sum()\nconv","key":"H0evxFLTOO"},{"type":"outputs","id":"xNBdaqn7ZWejt-mrZEAwz","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":45,"metadata":{},"data":{"text/plain":{"content":"array([[ 7., 12., 10.,  2.],\n       [ 4., 15., 16., 10.],\n       [10.,  6., 15.,  6.],\n       [ 8., 10.,  4.,  3.]])","content_type":"text/plain"}}},"children":[],"key":"hiKMCbwTi3"}],"key":"DWaMQQ5hhp"}],"key":"jmxq8Db5aY"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"プーリング層","position":{"start":{"line":1,"column"