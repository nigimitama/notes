KWFbV"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"strong","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"畳み込み（convolution）層","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"zFIKkYuliQ"}],"key":"OK6133WPo9"},{"type":"text","value":" は形状を維持する","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"bO9iy1XocI"}],"key":"lvahcHSMUd"}],"key":"WVBy8zCRtp"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"計算","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"sxpKlUkkfq"}],"identifier":"id","label":"計算","html_id":"id-1","implicit":true,"key":"dqtL4Jr08v"}],"key":"tBIrXt08fo"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"畳み込み層","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"yx3vx3sAH8"}],"identifier":"id","label":"畳み込み層","html_id":"id-2","implicit":true,"key":"OJJU4gxb13"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"チャネルごとに、","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ET6IxxI4bG"},{"type":"strong","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"カーネル（フィルター）","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"PYvc0eQ2ms"}],"key":"O6rZRzEAdr"},{"type":"text","value":" と呼ばれる行列を画像の行列と要素ごとに積をとり、総和をとる","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"hIg0at4wfx"}],"key":"JzaxzlKX4B"}],"key":"LubCLIcNA2"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\n\nimg = np.array([\n    [1, 2, 3, 0],\n    [0, 1, 2, 3],\n    [3, 0, 1, 2],\n    [2, 3, 0, 1],\n])\n\nker = np.array([\n    [2, 0, 1],\n    [0, 1, 2],\n    [1, 0, 2],\n])\n\nH, W = img.shape\nK = ker.shape[0]\n\nconv = np.zeros((H - K + 1, W - K + 1))\nfor i in range(H - K + 1):\n    for j in range(W - K + 1):\n        conv[i, j] = (img[i:i+K, j:j+K] * ker).sum()\nconv","key":"pIxF4AYoz1"},{"type":"outputs","id":"0eC4uuDWsKn6sMBvC9Nqp","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":33,"metadata":{},"data":{"text/plain":{"content":"array([[15., 16.],\n       [ 6., 15.]])","content_type":"text/plain"}}},"children":[],"key":"Uk4h7zpZPZ"}],"key":"VswhJINqah"}],"key":"POWLITrnJq"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"パディング","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"KqPOlQX602"}],"identifier":"id","label":"パディング","html_id":"id-3","implicit":true,"key":"JD7j6dBpkx"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"畳み込みを行う際に、入力データの周囲に固定のデータ（例えば0など）を埋めることがある。これを ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"V6A7ZzqRGy"},{"type":"strong","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"パディング（padding）","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"hp8lWyRw9q"}],"key":"T3vSpObvHu"},{"type":"text","value":" という。","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ozCtns3ZCP"}],"key":"JuvqTDViie"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"パディングにより畳み込み後の行列のサイズを調整できる","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"pog1wHKlEa"}],"key":"MX44LITfw4"}],"key":"ZiRcA8TuWk"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\n\n# padding\nimg = np.array([\n    [1, 2, 3, 0],\n    [0, 1, 2, 3],\n    [3, 0, 1, 2],\n    [2, 3, 0, 1],\n])\n\nH, W = img.shape\nimg_pad = np.zeros((H+2, W+2))\nimg_pad[1:-1, 1:-1] = img\nimg_pad","key":"sFIiXgTYUb"},{"type":"outputs","id":"YHGp4jShu166VTZLo6rF6","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":41,"metadata":{},"data":{"text/plain":{"content":"array([[0., 0., 0., 0., 0., 0.],\n       [0., 1., 2., 3., 0., 0.],\n       [0., 0., 1., 2., 3., 0.],\n       [0., 3., 0., 1., 2., 0.],\n       [0., 2., 3., 0., 1., 0.],\n       [0., 0., 0., 0., 0., 0.]])","content_type":"text/plain"}}},"children":[],"key":"Elrj3O25A9"}],"key":"ZmCl4S21cY"}],"key":"p4p9unBQfe"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# 畳み込み後も 4 x 4 を維持\nimg = img_pad\nH, W = img.shape\nconv = np.zeros((H - K + 1, W - K + 1))\nfor i in range(H - K + 1):\n    for j in range(W - K + 1):\n        conv[i, j] = (img[i:i+K, j:j+K] * ker).sum()\nconv","key":"J6MZ7LbHDm"},{"type":"outputs","id":"KwwgXBK47XdylNYAZfzxG","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":45,"metadata":{},"data":{"text/plain":{"content":"array([[ 7., 12., 10.,  2.],\n       [ 4., 15., 16., 10.],\n       [10.,  6., 15.,  6.],\n       [ 8., 10.,  4.,  3.]])","content_type":"text/plain"}}},"children":[],"key":"haJA3k1IRA"}],"key":"E6StzHBDa2"}],"key":"jsGpHBPz9z"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"プーリング層","position":{"start":{"line":1,"column"