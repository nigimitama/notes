gEui7"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"strong","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"畳み込み（convolution）層","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"YixiL6YlnC"}],"key":"QQDp35z5VE"},{"type":"text","value":" は形状を維持する","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"rkQQNlZMRH"}],"key":"Zg81EbD0sD"}],"key":"UguB6nJZWT"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"計算","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"kmSZ0s3VRc"}],"identifier":"id","label":"計算","html_id":"id-1","implicit":true,"key":"EiyBEAJLPB"}],"key":"p5729afn95"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"畳み込み層","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Z3RXQ8rWNu"}],"identifier":"id","label":"畳み込み層","html_id":"id-2","implicit":true,"key":"visTiXHWhS"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"チャネルごとに、","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"IkEVmrXukT"},{"type":"strong","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"カーネル（フィルター）","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"SDRjz8PcrZ"}],"key":"sy735afwC2"},{"type":"text","value":" と呼ばれる行列を画像の行列と要素ごとに積をとり、総和をとる","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"pJFMQ0w6RN"}],"key":"XVk1itfs50"}],"key":"sjmvnlHx6R"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\n\nimg = np.array([\n    [1, 2, 3, 0],\n    [0, 1, 2, 3],\n    [3, 0, 1, 2],\n    [2, 3, 0, 1],\n])\n\nker = np.array([\n    [2, 0, 1],\n    [0, 1, 2],\n    [1, 0, 2],\n])\n\nH, W = img.shape\nK = ker.shape[0]\n\nconv = np.zeros((H - K + 1, W - K + 1))\nfor i in range(H - K + 1):\n    for j in range(W - K + 1):\n        conv[i, j] = (img[i:i+K, j:j+K] * ker).sum()\nconv","key":"D1huxgYY5a"},{"type":"outputs","id":"m1e_93wx-2j_UuyrAjLmG","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":33,"metadata":{},"data":{"text/plain":{"content":"array([[15., 16.],\n       [ 6., 15.]])","content_type":"text/plain"}}},"children":[],"key":"m8Fm4enE3R"}],"key":"eNn1K1hR7O"}],"key":"KabfH32i0n"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"パディング","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"KZs5LvBDRe"}],"identifier":"id","label":"パディング","html_id":"id-3","implicit":true,"key":"d6Wk9jXkBc"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"畳み込みを行う際に、入力データの周囲に固定のデータ（例えば0など）を埋めることがある。これを ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"VFKwRM5ewv"},{"type":"strong","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"パディング（padding）","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"AGsKwSteKK"}],"key":"eVtkzRT7vg"},{"type":"text","value":" という。","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"kIQCPTAH7X"}],"key":"CGpmj2rJQT"},{"type":"paragraph","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"children":[{"type":"text","value":"パディングにより畳み込み後の行列のサイズを調整できる","position":{"start":{"line":5,"column":1},"end":{"line":5,"column":1}},"key":"sadRDs0Gbt"}],"key":"ma3P4fkgHf"}],"key":"LONTcq3lUM"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import numpy as np\n\n# padding\nimg = np.array([\n    [1, 2, 3, 0],\n    [0, 1, 2, 3],\n    [3, 0, 1, 2],\n    [2, 3, 0, 1],\n])\n\nH, W = img.shape\nimg_pad = np.zeros((H+2, W+2))\nimg_pad[1:-1, 1:-1] = img\nimg_pad","key":"aLCfaYseqS"},{"type":"outputs","id":"XFg5QglFNOzuEvXJTkWvQ","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":41,"metadata":{},"data":{"text/plain":{"content":"array([[0., 0., 0., 0., 0., 0.],\n       [0., 1., 2., 3., 0., 0.],\n       [0., 0., 1., 2., 3., 0.],\n       [0., 3., 0., 1., 2., 0.],\n       [0., 2., 3., 0., 1., 0.],\n       [0., 0., 0., 0., 0., 0.]])","content_type":"text/plain"}}},"children":[],"key":"LiR6lrCWDk"}],"key":"YaExk7A6TW"}],"key":"k6S9ExVVWQ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# 畳み込み後も 4 x 4 を維持\nimg = img_pad\nH, W = img.shape\nconv = np.zeros((H - K + 1, W - K + 1))\nfor i in range(H - K + 1):\n    for j in range(W - K + 1):\n        conv[i, j] = (img[i:i+K, j:j+K] * ker).sum()\nconv","key":"HN9DXhvfNQ"},{"type":"outputs","id":"EGjH9UCf5pWjm79SfUfnX","children":[{"type":"output","jupyter_data":{"output_type":"execute_result","execution_count":45,"metadata":{},"data":{"text/plain":{"content":"array([[ 7., 12., 10.,  2.],\n       [ 4., 15., 16., 10.],\n       [10.,  6., 15.,  6.],\n       [ 8., 10.,  4.,  3.]])","content_type":"text/plain"}}},"children":[],"key":"y3IICfHU4t"}],"key":"zR6sFRKxZJ"}],"key":"Dz2N4Sv2cS"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"プーリング層","position":{"start":{"line":1,"column"