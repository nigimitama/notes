matplotlib_fontja\nimport matplotlib.pyplot as plt\nimport scipy.stats as st\n\n# 標準正規分布データ\nrng = np.random.default_rng(0)\ndata = rng.normal(0, 1, 100_000)\n\n# 四分位数とIQR\nq1, q3 = np.percentile(data, [25, 75])\niqr = q3 - q1\nlower = q1 - 1.5 * iqr\nupper = q3 + 1.5 * iqr\n\n# 各範囲\nlimits = {\n    \"95%範囲 (±1.96σ)\": (-1.96, 1.96),\n    \"99%範囲 (±2.58σ)\": (-2.58, 2.58),\n    \"Tukey閾値 (±1.5IQR≃±2.70σ)\": (lower, upper),\n}\n\n# 確率密度\nx = np.linspace(-4, 4, 500)\npdf = st.norm.pdf(x)\n\n# 図を描画\nplt.figure(figsize=(9, 5))\nplt.plot(x, pdf, 'k-', lw=2, label=\"標準正規分布 N(0,1)\")\nplt.hist(data, bins=80, density=True, alpha=0.3, label=\"ヒストグラム\")\n\n# 範囲線の描画\ncolors = {\"95%範囲 (±1.96σ)\": \"green\", \"99%範囲 (±2.58σ)\": \"orange\", \"Tukey閾値 (±1.5IQR≃±2.70σ)\": \"red\"}\n\nfor label, (lo, hi) in limits.items():\n    plt.axvline(lo, color=colors[label], linestyle='--', lw=2)\n    plt.axvline(hi, color=colors[label], linestyle='--', lw=2, label=label)\n    plt.fill_between(x, 0, pdf, where=(x >= lo) & (x <= hi), color=colors[label], alpha=0.1)\n\n# 四分位数線\nplt.axvline(q1, color='blue', linestyle=':', lw=1.5, label=f\"Q1 = {q1:.2f}\")\nplt.axvline(q3, color='blue', linestyle=':', lw=1.5, label=f\"Q3 = {q3:.2f}\")\n\nplt.title(\"標準正規分布における外れ値閾値と信頼範囲の比較\")\nplt.xlabel(\"Z\")\nplt.ylabel(\"確率密度\")\nplt.legend(loc=\"upper left\", fontsize=9)\nplt.tight_layout()\nplt.show()\n\n# 数値表示\nprint(f\"Q1 = {q1:.3f}, Q3 = {q3:.3f}, IQR = {iqr:.3f}\")\nprint(f\"Tukey下限 = {lower:.3f}, 上限 = {upper:.3f}\")\n","visibility":"hide","key":"auYZd3DEI5"},{"type":"outputs","id":"uP1j9qaSXRxmA-EuLPQWM","children":[{"type":"output","jupyter_data":{"output_type":"display_data","metadata":{},"data":{"image/png":{"content_type":"image/png","hash":"e215ef6ead65618dbad8d8927af26e0d","path":"/notes/build/e215ef6ead65618dbad8d8927af26e0d.png"},"text/plain":{"content":"<Figure size 900x500 with 1 Axes>","content_type":"text/plain"}}},"children":[],"key":"qGLGnFWLki"},{"type":"output","jupyter_data":{"name":"stdout","output_type":"stream","text":"Q1 = -0.673, Q3 = 0.676, IQR = 1.349\nTukey下限 = -2.697, 上限 = 2.700\n"},"children":[],"key":"nXoq9YiKnu"}],"visibility":"show","key":"vjdvi23F28"}],"visibility":"show","key":"IUIsViC9A8"}],"key":"OKnUWVCW3s"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"Wasserstein 距離（EMD）","url":"/statistics/metric/wasserstein-distance","group":"統計学"},"next":{"title":"欠測データ","url":"/statistics/missing-data","group":"統計学"}}},"domain":"http://localhost:3000"}